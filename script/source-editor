#!/usr/bin/perl
# ==========================================================================
# source-editor - Gtk3::SourceEditor standalone runner
#
# Dual-purpose: interactive editor AND macro/snapshot harness.
#
# Interactive mode (default):
#   perl script/source-editor [OPTIONS] [FILE]
#
# Macro mode (run a macro then exit):
#   perl script/source-editor --macro FILE --macro-run NAME [OPTIONS]
#
# OPTIONS
# =======
#   -C, --config=FILE            Load settings from config file
#   -t, --theme=NAME             Theme name (default, dark, light, solarized)
#   -r, --read-only              Open file in read-only mode
#   -f, --font-size=N            Font point size (default: 0 = theme default)
#   -w, --[no-]wrap              Word wrap (default: on)
#   -n, --no-line-numbers        Hide line number gutter
#   -b, --[no-]cursor-block      Block cursor (default: on)
#   -H, --[no-]highlight-current-line  Highlight cursor line (default: on)
#   -D, --debug-key              Print key event debug info to stderr
#   -h, --help                   Show help
#
# Macro/snapshot options:
#   --macro FILE                 Load a macro file
#   --macro-run 'NAME [ARGS]'    Run named macro (exits after completion)
#   --snapshot-dir DIR           Directory for macro snapshots (default: .)
#   --snapshot-delay MS          Delay before macro runs (default: 500)
#   --language ID                Force syntax highlighting language
#   --size WxH                   Window size (default: 800x600)
#   --code TEXT                  Set buffer text directly
#   --debug                      Print millisecond timing to stderr
#   --vim-mode 0|1               Enable vim mode (default: 1)
# ==========================================================================

use strict;
use warnings;
use FindBin qw($RealBin);

# Add lib dir (works from both script/ and project root)
use lib "$RealBin/../lib";
use lib "$RealBin/../../lib";

# Ensure CWD is the project root so relative theme paths work
my $project_root = (-d "$RealBin/../lib/Gtk3") ? "$RealBin/.." : "$RealBin/../..";
chdir($project_root) or warn "Cannot chdir to project root: $!";

# Start debug timer BEFORE GTK init so we capture full startup time
use Time::HiRes qw(time);
my $debug    = 0;
my $debug_t0 = Time::HiRes::time();
sub _dbg {
    return unless $debug;
    my $elapsed = sprintf("%.3f", Time::HiRes::time() - $debug_t0);
    printf STDERR "[debug %7s ms] %s\n", $elapsed, join(" ", @_);
}

use Getopt::Long qw(:config no_ignore_case bundling);
use Glib ('TRUE', 'FALSE');
use Gtk3 '-init';
use Gtk3::SourceEditor;

# --- Parse options ---
my $config_file             = '';
my $theme_name              = 'default';
my $read_only               = 0;
my $font_size               = 0;
my $wrap_enabled            = 1;
my $no_line_numbers         = 0;
my $block_cursor            = 1;
my $highlight_current_line  = 1;
my $help                    = 0;
my $debug_key               = 0;
my $filename                = '';

# Macro / snapshot options
my $macro_file              = undef;
my $macro_run               = undef;
my $snapshot_dir            = '.';
my $snapshot_delay          = 500;
my $language                = undef;
my $size                    = '800x600';
my $code                    = undef;
my $vim_mode                = undef;

GetOptions(
    'config|C=s'                     => \$config_file,
    'theme=s'                        => \$theme_name,
    'read-only|r'                    => \$read_only,
    'font-size|f=i'                  => \$font_size,
    'wrap|w!'                        => \$wrap_enabled,
    'no-line-numbers|n'              => \$no_line_numbers,
    'cursor-block|b!'                => \$block_cursor,
    'highlight-current-line|H!'      => \$highlight_current_line,
    'help|h'                         => \$help,
    'debug-key|D'                    => \$debug_key,
    'vim-mode=i'                     => \$vim_mode,
    'macro=s'                        => \$macro_file,
    'macro-run=s'                    => \$macro_run,
    'snapshot-dir=s'                 => \$snapshot_dir,
    'snapshot-delay=i'               => \$snapshot_delay,
    'language=s'                     => \$language,
    'size=s'                         => \$size,
    'code=s'                         => \$code,
    'debug'                          => \$debug,
);

if ($help) {
    print <<"USAGE";
Usage: source-editor [OPTIONS] [FILE]

Options:
  -C, --config=FILE            Load settings from a configuration file
  -t, --theme=NAME             Theme name (default, dark, light, solarized)
  -r, --read-only              Open file in read-only mode
  -f, --font-size=N            Set font point size (default: 0 = theme default)
  -w, --[no-]wrap              Enable/disable word wrap (default: on)
  -n, --no-line-numbers        Hide line number gutter
  -b, --[no-]cursor-block      Enable/disable block cursor (default: on)
  -H, --[no-]highlight-current-line
                                Highlight current line (default: on)
  -D, --debug-key              Print key event debug info to stderr
  -h, --help                   Show this help message

Macro/snapshot options:
  --macro FILE                 Load a macro file
  --macro-run 'NAME [ARGS]'    Run named macro then exit
  --snapshot-dir DIR           Snapshot output directory (default: .)
  --snapshot-delay MS          Delay before macro runs (default: 500)
  --language ID                Force syntax highlighting language
  --size WxH                   Window size (default: 800x600)
  --code TEXT                  Set buffer text directly
  --vim-mode 0|1               Enable vim mode (default: 1)
  --debug                      Print timing to stderr

Configuration file settings are used as defaults.  Command-line options
override the corresponding config file values.

The editor provides Vim-like modal keybindings.  Use :q to quit,
:w to save, :wq to save and quit, i/a/o to enter insert mode.
Press Escape to return to normal mode.
USAGE
    exit 0;
}

_dbg("GTK init done");

# Positional argument: file to open
$filename = $ARGV[0] if @ARGV;

# --- Parse window size ---
my ($win_w, $win_h) = (800, 600);
if ($size =~ /^(\d+)x(\d+)$/) {
    ($win_w, $win_h) = ($1, $2);
}

# --- Resolve theme file path ---
my $theme_file;
if ($theme_name eq 'default') {
    $theme_file = "$project_root/themes/default.xml";
} elsif ($theme_name !~ m{[/\\.]}) {
    $theme_file = "$project_root/themes/theme_$theme_name.xml";
} else {
    $theme_file = $theme_name;
}

# --- Build editor options ---
my %editor_opts = (
    file                    => (length $filename ? $filename : undef),
    theme_file              => $theme_file,
    font_size               => $font_size,
    wrap                    => $wrap_enabled,
    read_only               => $read_only,
    show_line_numbers       => !$no_line_numbers,
    block_cursor            => $block_cursor,
    highlight_current_line  => $highlight_current_line,
    debug                   => $debug,
    debug_key               => $debug_key,
    window                  => undef,  # set below
    on_close                => sub {
        my $final_text = shift;
        print "--- WINDOW CLOSED ---\nCaptured Text:\n$final_text\n";
    },
);

# Config file is passed through; SourceEditor merges it with lower priority.
$editor_opts{config_file} = $config_file if $config_file && -f $config_file;

# Macro-specific options
if (defined $vim_mode) {
    $editor_opts{vim_mode} = $vim_mode;
}
if ($language) {
    $editor_opts{force_language} = $language;
}

_dbg("building editor (theme=%s)", $theme_name);
my $editor = Gtk3::SourceEditor->new(%editor_opts);
_dbg("editor created");

# Set buffer text if --code given
if (defined $code) {
    $editor->get_buffer->set_text($code);
    $editor->get_buffer->place_cursor($editor->get_buffer->get_start_iter);
}

# --- Build window ---
my $window = Gtk3::Window->new('toplevel');
$window->set_title($filename || "New File");
$window->set_default_size($win_w, $win_h);
$window->signal_connect(delete_event => sub { Gtk3->main_quit; return FALSE });
$window->add($editor->get_widget);
_dbg("widget added to window");
$window->show_all;
_dbg("show_all complete");

# ==========================================================================
# Macro support
# ==========================================================================

sub _parse_macro_run {
    my ($str) = @_;
    return () unless defined $str && length $str;
    if ($str =~ /^(\S+)(?:\s+(.*))?$/) {
        my $name = $1;
        my $args_str = $2 // '';
        my @args = split(/\s+/, $args_str);
        @args = () if @args == 1 && $args[0] eq '';
        return ($name, @args);
    }
    return ($str);
}

# If --macro given, load and optionally run it
if ($macro_file) {
    require Gtk3::SourceEditor::Macro;
    Gtk3::SourceEditor::Macro->load(file => $macro_file);

    if ($macro_run) {
        my ($macro_name, @macro_args) = _parse_macro_run($macro_run);

        Glib::Timeout->add($snapshot_delay, sub {
            _dbg("running macro '$macro_name'");

            # Ensure the text view has keyboard focus so that
            # selection highlighting uses the focused (non-backdrop)
            # colours from the style scheme.  In a headless Xvfb
            # environment no window receives focus automatically,
            # so the selection may be rendered with a nearly
            # invisible backdrop colour unless we grab focus here.
            eval { $editor->get_textview->grab_focus() };

            require Gtk3::SourceEditor::Macro::Context;
            my $ctx = Gtk3::SourceEditor::Macro::Context->new(
                editor       => $editor,
                window       => $window,
                snapshot_dir => $snapshot_dir,
                macro_name   => $macro_name,
            );

            eval {
                Gtk3::SourceEditor::Macro->run($macro_name, $ctx, @macro_args);
            };
            if ($@) {
                print STDERR "Macro '$macro_name' failed: $@\n";
            }

            Gtk3->main_quit;
            return FALSE;
        });

        Gtk3->main;
        exit 0;
    }
}

# --- Interactive mode ---
Gtk3->main;
