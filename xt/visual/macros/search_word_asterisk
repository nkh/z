my $CODE = <<'END_CODE';
foo bar foo baz foo
END_CODE

{
    desc => q{* searches forward for the word under cursor},
    description => <<'END_DESC',
## Macro: `xt/visual/macros/search_word_asterisk`

**\*** searches forward for the whole word under the cursor. With cursor on "foo", it finds the next occurrence of "foo".

**Keys:** `*`

**initial.png**
- Cursor at line 1, col 0 (on 'f' of first "foo")
- Line: `foo bar foo baz foo`

**after_star.png**
- Cursor on second "foo" at col 8
- All "foo" occurrences highlighted
- Search pattern set to `\<foo\>` (word boundary search)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('*');
        $ctx->delay(300);
        $ctx->snapshot('after_star');
    },
}
