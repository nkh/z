my $CODE = <<'END_CODE';
hello world hello again
foo bar baz hello
END_CODE

{
    desc => q{* searches forward for word under cursor},
    description => <<'END_DESC',
Action: * searches forward for the word under the cursor

_1.png (initial state):
- Dark theme with 2 lines
- Cursor at line 1, col 0 (on 'h' of first 'hello')

Action: keystrokes "*"

_2.png (after action):
- All occurrences of "hello" highlighted
- Cursor moved to next occurrence of "hello" on line 2
- Search pattern set to "hello"
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('*');
        $ctx->delay(300);
        $ctx->snapshot('2');
    },
}
