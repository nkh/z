my $CODE = <<'END_CODE';
This is a long line of text that should be wrapped when we apply the gq format command to it.
Second line is also here.
Third line exists too.
END_CODE

{
    desc => 'Visual gq formats and wraps selected lines',
    description => <<'END_DESC',
Action: V select lines, gq rewraps them

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "Vjjgq" (line-select 3 lines, format)

_2.png (after action):
- Lines are rewrapped to fit within 80 columns
- Content preserved but reformatted
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('Vjjgq');
        $ctx->delay(200);
        $ctx->snapshot('2');
    },
}
