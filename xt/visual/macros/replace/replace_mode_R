{
    desc => q{R enters replace mode},
    description => <<'END_DESC',
# replace_mode_R, R enters replace mode

Macro: `xt/visual/macros/replace/replace_mode_R`

## initial.png

- Cursor: 1, 0
- Line 1  : hello world

## after_replace_mode.png

- Keys    : R


END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('R');
        $ctx->delay(50);
        $ctx->type('BYE ');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('after_replace_mode');
    },
}
__DATA__
hello world
