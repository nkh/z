{
    desc => q{Backspace in replace mode restores overwritten character},
    description => <<'END_DESC',
# replace_mode_backspace, Backspace in replace mode restores overwritten character

Macro: `xt/visual/macros/replace/replace_mode_backspace`

## initial.png

- Cursor: 1, 0
- Line 1  : hello world

## after_backspace.png

- Keys    : R \b


END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('R');
        $ctx->delay(50);
        $ctx->type('XY');
        $ctx->delay(50);
        $ctx->keys('\b');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('after_backspace');
    },
}
__DATA__
hello world
