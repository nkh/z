my $CODE = <<'END_CODE';
hello world this is a test
line two
END_CODE

{
    desc => q{Visual char change},
    description => <<'END_DESC',
Action: v selects chars, c changes (replaces with typed text)

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "vlllcXXEscape" (select, change, type, exit)

_2.png (after action):
- "hell" replaced with "XX"
- Line 1: "XXo world this is a test"
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('vlllc');
        $ctx->delay(50);
        $ctx->type('XX');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
