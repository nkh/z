my $CODE = <<'END_CODE';
hello world this is a test
line two
END_CODE

{
    desc => q{Reverse find ,},
    description => <<'END_DESC',
Action: , reverses last find

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "fo;," (find, repeat, reverse)

_2.png (after action):
- fo finds 'o' at col 4
- ; finds next 'o' at col 7
- , goes back to col 4
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('fo;,');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
