END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_language('perl');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('llll');
        $ctx->delay(50);
        $ctx->keys('ci(');
        $ctx->delay(50);
        $ctx->type('x, y');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('after_ci_paren');
