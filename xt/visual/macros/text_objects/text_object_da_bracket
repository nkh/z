{
    desc => 'da[ deletes text including square brackets',
    description => <<'END_DESC',
Macro: `xt/visual/macros/text_object_da_bracket`

Tests the `da[` text object which deletes text **including** the
square brackets themselves.

**initial.png** — Cursor on '1' inside the brackets at line 1 col 12.

Keys: `da[`

**after_da_bracket.png** — The entire `[1, 2, 3]` including both
brackets is removed. Line 1 now reads `my @arr = ;`.
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_language('perl');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('llllllllllll');
        $ctx->delay(50);
        $ctx->keys('da[');
        $ctx->delay(100);
        $ctx->snapshot('after_da_bracket');
    },
}
__DATA__
my @arr = [1, 2, 3];
