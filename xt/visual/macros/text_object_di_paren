my $CODE = <<'END_CODE';
say("hello world");
my $x = "test";
END_CODE

{
    desc => q{di( deletes text inside parentheses},
    description => <<'END_DESC',
Action: di( deletes text inside the nearest parentheses

_1.png (initial state):
- Cursor at line 1, col 4 (on '(' character)

Action: keystrokes "di(" (delete inner parentheses)

_2.png (after action):
- Text between ( and ) deleted, parentheses remain
- Line 1 now: 'say();'
- Cursor at line 1, col 4
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->editor->set_language('perl');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('llll');
        $ctx->delay(50);
        $ctx->keys('di(');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
