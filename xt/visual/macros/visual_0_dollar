my $CODE = <<'END_CODE';
hello world this is
line two
END_CODE

{
    desc => q{Visual 0/$ motions},
    description => <<'END_DESC',
Action: v select, 0 to line start, $ to line end

_1.png (initial state):
- Cursor at line 1, col 5 (on 'w')

Action: keystrokes "5lv0$" (visual, move to start, then end)

_2.png (after action):
- Entire line 1 selected (from col 0 to end)
- Mode label: "-- VISUAL --"
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('5lv0$');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
