my $CODE = <<'END_CODE';
one
two
three
four
five
six
END_CODE

{
    desc => 'Visual 3d deletes selection with count prefix',
    description => <<'END_DESC',
Action: v select text, 3d deletes 3 times (effectively normal delete)

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "vjll3d" (char-select down+right, then 3d)

_2.png (after action):
- Selected text deleted
- Buffer contents changed based on what was selected
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('vjll');
        $ctx->delay(50);
        $ctx->keys('3d');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
