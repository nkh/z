my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => q{Count paste 3p},
    description => <<'END_DESC',
Action: yy yanks line, 3p pastes 3 copies

_1.png (initial state):
- 3 lines of text, cursor at line 1

Action: keystrokes "yy3p" (yank line, paste 3 times)

_2.png (after action):
- Line 1 duplicated 3 more times (4 total copies)
- Buffer now has 6 lines
- Cursor on last pasted line
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('yy3p');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
