my $CODE = <<'END_CODE';
#!/usr/bin/perl
use strict;
use warnings;

package My::Module;

sub new {
    my ($class, %opts) = @_;
    return bless \%opts, $class;
}

sub process {
    my ($self, $data) = @_;
    die "No data provided" unless $data;
    my @results;
    for my $item (@$data) {
        push @results, $self->_transform($item);
    }
    return \@results;
}

sub _transform {
    my ($self, $item) = @_;
    return uc($item);
}

1;
END_CODE

{
    desc => q{Command entry visible},
    description => <<'END_DESC',
Action: : enters command mode, showing the command entry

_1.png (initial state):
- Dark theme, Normal mode
- Command entry not visible

Action: keystrokes ":" (colon enters command mode)

_2.png (after action):
- Command entry visible at bottom of editor
- Cursor/insert point active in command entry
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->editor->set_language('perl');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys(':');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
