my $CODE = <<'END_CODE';
  hello world
  foo bar

END_CODE

{
    desc => q{First non-blank ^ motion},
    description => <<'END_DESC',
Action: `^` moves to first non-blank character on the line

Macro: `xt/visual/macros/basic_navigation_first_nonblank`

**initial.png** (before):
- Line 1: `  hello world` (two leading spaces)
- Cursor at line 1, col 0

Keys: `^`

**after_action.png** (after):
- Cursor at line 1, col 2 (on `h`, the first non-blank character)
- No text change

END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('^');
        $ctx->delay(100);
        $ctx->snapshot('after_action');
    },
}
