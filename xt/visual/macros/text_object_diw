my $CODE = <<'END_CODE';
hello   world   this
END_CODE

{
    desc => 'diw deletes inner word without surrounding whitespace',
    description => <<'END_DESC',
Macro: `xt/visual/macros/text_object_diw`

Tests the `diw` text object which deletes the word under the cursor
but preserves surrounding whitespace.

**initial.png** — Cursor on 'h' of `hello` at line 1 col 0.

Keys: `diw`

**after_diw.png** — The word `hello` is removed but the trailing spaces
remain. Line 1 now reads `   world   this`. Cursor at col 0.
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('diw');
        $ctx->delay(100);
        $ctx->snapshot('after_diw');
    },
}
