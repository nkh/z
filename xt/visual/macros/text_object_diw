my $CODE = <<'END_CODE';
hello world  this is a test
line two
END_CODE

{
    desc => q{diw deletes inner word without surrounding whitespace},
    description => <<'END_DESC',
Action: diw deletes only the word under cursor (preserves whitespace)

_1.png (initial state):
- Cursor at line 1, col 6 (on 'w' of 'world')

Action: keystrokes "diw" (delete inner word)

_2.png (after action):
- "world" deleted but surrounding spaces preserved
- Line 1 now: "hello   this is a test"
- Cursor at line 1, col 6
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('ww');
        $ctx->delay(50);
        $ctx->keys('diw');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
