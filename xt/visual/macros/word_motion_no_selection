my $CODE = <<'END_CODE';
one two three
four five six
seven eight nine
END_CODE

{
    desc => q{Word motion leaves no selection},
    description => <<'END_DESC',
Action: w/b/e sequence should not leave a visual selection

_1.png (initial state):
- Cursor at line 1, col 0
- No selection

Action: keystrokes "wbbe" (word motions back and forth)

_2.png (after action):
- Cursor moved but NO selection visible
- Mode label still shows "-- NORMAL --"
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('wbbe');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
