my $CODE = <<'END_CODE';
one two three four five
six seven eight nine ten
END_CODE

{
    desc => 'w/b/e word motions leave no visual selection in normal mode',
    description => <<'END_DESC',
Macro: `xt/visual/macros/word_motion_no_selection`

Tests that word motion commands (`w`, `b`, `e`) in normal mode move the
cursor without entering visual mode or leaving a selection.

Keys: `w` then `b` then `b` then `e`

- **word_motion_no_selection_initial.png**: Cursor at line 1 col 0 on "one"; mode shows "-- NORMAL --", no selection.
- **word_motion_no_selection_after_w.png**: After `w`, cursor moved to "two"; still normal mode, no selection.
- **word_motion_no_selection_after_bbe.png**: After `b` `b` `e`, cursor on end of "one"; still normal mode, no selection.
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('w');
        $ctx->delay(100);
        $ctx->snapshot('after_w');
        $ctx->delay(100);
        $ctx->keys('bbe');
        $ctx->delay(100);
        $ctx->snapshot('after_bbe');
    },
}
