my $CODE = <<'END_CODE';
hello world
this is line two
the third line here
END_CODE

{
    desc => q{Visual line toggle case},
    description => <<'END_DESC',
Action: V selects lines, ~ toggles case of entire selection

_1.png (initial state):
- Cursor at line 1

Action: keystrokes "Vj~" (select 2 lines, toggle case)

_2.png (after action):
- Lines 1-2 case toggled: "HELLO WORLD", "THIS IS LINE TWO"
- Line 3 unchanged
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('Vj~');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
