my $CODE = <<'END_CODE';
line one
line two
line three
line four
line five
line six
line seven
line eight
line nine
line ten
END_CODE

{
    desc => q{Mark set and jump `a},
    description => <<'END_DESC',
Action: ma sets mark, move, then `a returns

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "majjj`a" (set mark, move down 3, jump back)

_2.png (after action):
- Cursor back at line 1, col 0 (exact mark position)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('majjj`a');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
