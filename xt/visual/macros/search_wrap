my $CODE = <<'END_CODE';
alpha beta
gamma alpha
delta epsilon
END_CODE

{
    desc => q{Search wraps around the end of the buffer},
    description => <<'END_DESC',
## Macro: `xt/visual/macros/search_wrap`

Search wraps around the buffer when it reaches the end. After finding "alpha" on line 1, pressing `n` finds the next "alpha" on line 2, and another `n` wraps back to line 1.

**Keys:** `/alpha\n` then `nn`

**initial.png**
- Cursor at line 1, col 0
- "alpha" appears on lines 1 and 2

**after_first_search.png**
- Cursor on first "alpha" on line 1, col 0

**after_first_n.png**
- Cursor on second "alpha" on line 2, col 6

**after_wrap_n.png**
- Cursor wrapped back to "alpha" on line 1, col 0
- Search wrapped from end of buffer back to top
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('/alpha\n');
        $ctx->delay(300);
        $ctx->snapshot('after_first_search');
        $ctx->delay(100);
        $ctx->keys('n');
        $ctx->delay(200);
        $ctx->snapshot('after_first_n');
        $ctx->delay(100);
        $ctx->keys('n');
        $ctx->delay(200);
        $ctx->snapshot('after_wrap_n');
    },
}
