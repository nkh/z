my $CODE = <<'END_CODE';
hello world this is a test
line two
END_CODE

{
    desc => q{D from middle of line},
    description => <<'END_DESC',
Action: D deletes from cursor to end of line

_1.png (initial state):
- Cursor at line 1, col 6 (on 'w')

Action: keystrokes "6lD" (delete from middle to EOL)

_2.png (after action):
- Line 1 truncated to "hello " (content from 'w' onward deleted)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('6lD');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
