my $CODE = <<'END_CODE';
abcd
efgh
ijkl
mnop
END_CODE

{
    desc => q{Visual block toggle case},
    description => <<'END_DESC',
Action: Ctrl-V selects block, ~ toggles case

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "Control-vjjll~" (block 3 rows x 3 cols, toggle case)

_2.png (after action):
- First 3 chars of first 3 lines uppercased
- Lines: "ABCd", "EFGh", "IJKl"
- Line 4 unchanged
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('Control-vjjll~');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
