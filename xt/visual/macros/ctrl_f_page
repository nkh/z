{
    desc => q{Ctrl-f full page forward},
    description => <<'END_DESC',
Action: Ctrl-f scrolls viewport forward one full page

_1.png (initial state):
- Cursor at line 1

Action: keystrokes "Control-f" (full page forward)

_2.png (after action):
- Viewport scrolled down one full page
- Cursor at bottom of new viewport
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('Control-f');
        $ctx->delay(200);
        $ctx->snapshot('2');
    },
}
