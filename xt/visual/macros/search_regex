my $CODE = <<'END_CODE';
hello.world
line two
END_CODE

{
    desc => q{Search regex metacharacters},
    description => <<'END_DESC',
Action: / with regex metacharacters

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "/h.l.oReturn" (regex pattern with dots)

_2.png (after action):
- "hello" matched (each dot matches a char)
- "hello" highlighted on line 1
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('/h.l.o\\n');
        $ctx->delay(300);
        $ctx->snapshot('2');
    },
}
