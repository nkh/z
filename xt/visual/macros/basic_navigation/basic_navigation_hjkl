{
    desc => q{Basic h/j/k/l cursor movement},
    description => <<'END_DESC',
Macro: `xt/visual/macros/basic_navigation_hjkl`

Tests the four basic cursor movement keys: `h` (left), `j` (down), `k` (up), `l` (right).

Keys: `l` → `l` → `j` → `j` → `h` → `k`

- **basic_navigation_hjkl_initial.png**: Cursor at line 1, col 0 on `H` of "Hello"
- **basic_navigation_hjkl_after_ll.png**: Cursor at line 1, col 2 on first `l` of "Hello" (moved right twice)
- **basic_navigation_hjkl_after_jj.png**: Cursor at line 3, col 2 on `e` of "one" (moved down twice)
- **basic_navigation_hjkl_after_hk.png**: Cursor at line 2, col 2 on first `o` of "foo" (left then up)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('ll');
        $ctx->delay(100);
        $ctx->snapshot('after_ll');
        $ctx->delay(100);
        $ctx->keys('jj');
        $ctx->delay(100);
        $ctx->snapshot('after_jj');
        $ctx->delay(100);
        $ctx->keys('hk');
        $ctx->delay(100);
        $ctx->snapshot('after_hk');
    },
}
__DATA__
Hello world
foo bar baz
one two three
alpha beta
gamma delta
