{
    desc => q{Line start/end motions $ and 0},
    description => <<'END_DESC',
Macro: `xt/visual/macros/basic_navigation_line`

Tests `$` (move to end of line) and `0` (move to start of line) motions.

Keys: `$` → `0`

- **basic_navigation_line_initial.png**: Cursor at line 1, col 0 on `t` of "the"
- **basic_navigation_line_after_dollar.png**: Cursor at line 1, col 24 on `s` of "jumps" (end of line)
- **basic_navigation_line_after_zero.png**: Cursor at line 1, col 0 on `t` of "the" (back to start)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('$');
        $ctx->delay(100);
        $ctx->snapshot('after_dollar');
        $ctx->delay(100);
        $ctx->keys('0');
        $ctx->delay(100);
        $ctx->snapshot('after_zero');
    },
}
