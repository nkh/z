my $CODE = <<'END_CODE';
hello world
END_CODE

{
    desc => q{s substitutes character},
    description => <<'END_DESC',
Action: `s` deletes the character under the cursor and enters insert mode

Macro: `xt/visual/macros/substitute_char_s`

**initial.png** (before):
- Line 1: `hello world`
- Cursor at line 1, col 0 (on `h`)

Keys: `sX`, `Escape`

**after_substitute.png** (after):
- Line 1: `Xello world` (`h` replaced with `X`)
- Cursor at line 1, col 1 (after `X`)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('sX');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('after_substitute');
    },
}
