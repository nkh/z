{
    desc => q{Bracket match % curly braces},
    description => <<'END_DESC',
Action: `%` jumps between matching curly braces

Macro: `xt/visual/macros/bracket_match_brace`

**initial.png** (before):
- Line 1: `sub foo {`
- Line 4: `}`
- Cursor at line 1, col 0

Keys: `9l` (move to `{`)

**on_brace.png** (cursor on `{`):
- Cursor at line 1, col 9 (on `{`)

Keys: `%`

**after_action.png** (after `%`):
- Cursor at line 4, col 0 (on matching `}`)
- No text change

END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_language('perl');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('9l');
        $ctx->delay(100);
        $ctx->snapshot('on_brace');
        $ctx->delay(100);
        $ctx->keys('%');
        $ctx->delay(100);
        $ctx->snapshot('after_action');
    },
}
