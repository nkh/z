my $CODE = <<'END_CODE';
line one
line two
line three
line four
line five
line six
line seven
line eight
line nine
line ten
END_CODE

{
    desc => q{:set number toggle},
    description => <<'END_DESC',
Action: :set number shows line numbers, :set nonumber hides

_1.png (initial state):
- Line numbers hidden (default)

Action: ex command ":set number"

_2.png (after action):
- Line numbers visible in gutter
- Numbers 1-10 (or as many as visible)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->ex('set number');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
