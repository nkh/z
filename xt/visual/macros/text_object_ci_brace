my $CODE = <<'END_CODE';
func({ key => 'value' });
END_CODE

{
    desc => 'ci{ change inner braces',
    description => <<'END_DESC',
Action: ci{ changes text inside curly braces

Macro: xt/visual/macros/text_object_ci_brace

**initial.png** (before):
- Line 1: func({ key => 'value' });
- Cursor at line 1, col 0

Keys: lllllllci{ + type REPLACED + Escape

**after_change.png** (after):
- Line 1: func({ REPLACED });
- Content between braces replaced, braces preserved
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('lllllllci{');
        $ctx->delay(100);
        $ctx->snapshot('in_insert_mode');
        $ctx->delay(50);
        $ctx->type('REPLACED');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('after_change');
    },
}
