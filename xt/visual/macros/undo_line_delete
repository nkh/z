my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => q{Undo restores deleted line},
    description => <<'END_DESC',
Action: dd deletes line, u restores it

_1.png (initial state):
- 3 lines of text, cursor at line 1

Action: keystrokes "ddu" (delete line, undo)

_2.png (after action):
- Original 3 lines restored
- Cursor position restored
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('ddu');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
