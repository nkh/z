__DATA__
#include <stdio.h>
#include <stdlib.h>

#define MAX_SIZE 100

/* Global configuration */
int verbose = 1;
double threshold = 0.5;

// Structure definition
typedef struct {
    int id;
    char name[64];
    double value;
} Record;

// Function declarations
int process_record(Record *r);
void print_summary(Record *records, int count);
int validate(const char *input);

int main(int argc, char *argv[]) {
    printf("Starting program...\n");
    if (argc < 2) {
        fprintf(stderr, "Usage: %s <filename>\n", argv[0]);
        return 1;
    }
    for (int i = 0; i < argc; i++) {
        printf("  arg[%d] = %s\n", i, argv[i]);
    }
    return 0;
}

int process_record(Record *r) {
    if (r == NULL) return -1;
    r->value *= threshold;
    return 0;
}

void print_summary(Record *records, int count) {
    int total = 0;
    for (int i = 0; i < count && i < MAX_SIZE; i++) {
        total += (int)records[i].value;
    }
    printf("Total: %d (from %d records)\n", total, count);
}
