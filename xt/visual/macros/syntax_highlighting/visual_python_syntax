#!/usr/bin/env python3
"""Source editor utilities module."""

from typing import List, Optional, Dict, Any
import json
import os


def load_config(path: str) -> Dict[str, Any]:
    """Load configuration from a JSON file."""
    if not os.path.exists(path):
        raise FileNotFoundError(f"Config not found: {path}")
    with open(path, 'r') as f:
        return json.load(f)


class SyntaxHighlighter:
    """Base class for syntax highlighting."""

    def __init__(self, language: str = "text"):
        self.language = language
        self._patterns: List[str] = []

    def add_pattern(self, pattern: str) -> None:
        self._patterns.append(pattern)

    def highlight(self, code: str) -> str:
        """Apply highlighting rules to source code."""
        result = code
        for pattern in self._patterns:
            # Apply each pattern in sequence
            result = self._apply(result, pattern)
        return result

    def _apply(self, text: str, pattern: str) -> str:
        """Apply a single highlighting pattern."""
        return text  # overridden in subclasses


def main() -> int:
    """Entry point for the utility."""
    config = load_config("config.json")
    highlighter = SyntaxHighlighter(language="python")

    if not config.get("enabled", False):
        print("Syntax highlighting is disabled")
        return 0

    print(f"Language: {highlighter.language}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
