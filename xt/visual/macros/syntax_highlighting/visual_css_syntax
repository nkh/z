{
    desc => q{CSS syntax},
    description => <<'END_DESC',
Syntax highlighting: CSS

Visual checks:
- Selectors (.editor, .gutter) colored
- Properties (font-family, color, background) colored
- Values (monospace, #d4d4d4, 12px) colored
- Comments (/* */) have comment color
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_language('css');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot();
    },
}
__DATA__
/* Editor base styles */
.editor {
    font-family: monospace;
    font-size: 14px;
    color: #d4d4d4;
    background: #1e1e1e;
    padding: 4px 8px;
    border: 1px solid #3c3c3c;
}

/* Gutter styling */
.gutter {
    background: #1e1e1e;
    color: #858585;
    border-right: 1px solid #3c3c3c;
    padding: 0 6px;
    min-width: 40px;
    text-align: right;
    user-select: none;
}

/* Selection highlight */
.editor::selection {
    background: #264f78;
}

/* Scrollbar styling */
.editor::-webkit-scrollbar {
    width: 14px;
    height: 14px;
}

.editor::-webkit-scrollbar-thumb {
    background: #424242;
    border: 3px solid #1e1e1e;
    border-radius: 7px;
}

/* Cursor line highlight */
.cursor-line {
    background: rgba(255, 255, 255, 0.04);
}

/* Search match highlight */
.search-match {
    background: #515c6a;
    border: 1px solid #515c6a;
}

/* Syntax colors */
.keyword    { color: #569cd6; }
.string     { color: #ce9178; }
.comment    { color: #6a9955; }
.number     { color: #b5cea8; }
.type       { color: #4ec9b0; }
