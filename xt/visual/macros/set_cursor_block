my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => ':set cursor=block changes cursor shape to block',
    description => <<'END_DESC',
Macro: `xt/visual/macros/set_cursor_block`

Tests that `:set cursor=block` sets the cursor shape to a block cursor.

Ex: `:set cursor=block`

- **set_cursor_block_initial.png**: Normal mode, default cursor style.
- **set_cursor_block_after_set.png**: Cursor shape changed to block. Mode label shows "-- NORMAL --".
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->ex('set cursor=block');
        $ctx->delay(200);
        $ctx->snapshot('after_set');
    },
}
