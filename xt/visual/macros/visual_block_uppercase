my $CODE = <<'END_CODE';
abcd
efgh
ijkl
mnop
qrst
END_CODE

{
    desc => 'Visual block uppercase U converts block to uppercase',
    description => <<'END_DESC',
Action: Ctrl-V block select, U uppercases all block text

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "Control-vjjlU" (block select 3 rows x 2 cols, uppercase)

_2.png (after action):
- First 2 chars of each of first 3 lines uppercased
- Lines: "ABcd", "EFgh", "IJkl"
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('Control-vjjl');
        $ctx->delay(50);
        $ctx->key('U');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
