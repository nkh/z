{
    desc => q{Viewport L (bottom of viewport)},
    description => <<'END_DESC',
Action: L moves cursor to bottom of viewport

_1.png (initial state):
- Cursor at line 1

Action: keystrokes "GkL" (go to near bottom, then L to bottom of viewport)

_2.png (after action):
- Cursor on last visible line of viewport
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('GkL');
        $ctx->delay(200);
        $ctx->snapshot('2');
    },
}
