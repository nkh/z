my $CODE = <<'END_CODE';
my $name = 'hello world';
my $x = 'test';
END_CODE

{
    desc => q{di' deletes text inside single quotes},
    description => <<'END_DESC',
Action: di' deletes text inside single quotes, preserving the quotes

_1.png (initial state):
- Cursor at line 1, col 11 (between quotes, on 'h' of 'hello')

Action: keystrokes "di'" (delete inner single quote)

_2.png (after action):
- Text between quotes deleted, quotes remain
- Line 1 now: "my $name = '';"
- Cursor at line 1, col 11
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->editor->set_language('perl');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('lllllllllll');
        $ctx->delay(50);
        $ctx->keys("di'");
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
