my $CODE = <<'END_CODE';
my @arr = [$a, $b, $c];
my $item = $arr[0];
END_CODE

{
    desc => q{di[ deletes text inside square brackets},
    description => <<'END_DESC',
Action: di[ deletes text inside the nearest square brackets

_1.png (initial state):
- Cursor at line 1, col 11 (on '[' character)

Action: keystrokes "di[" (delete inner brackets)

_2.png (after action):
- Text between [ and ] deleted, brackets remain
- Line 1 now: 'my @arr = [];'
- Cursor at line 1, col 11
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->editor->set_language('perl');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('lllllllllll');
        $ctx->delay(50);
        $ctx->keys('di[');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
