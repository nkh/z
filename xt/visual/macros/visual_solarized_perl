my $CODE = <<'END_CODE';
#!/usr/bin/perl
use strict;
use warnings;

package My::Module;

sub new {
    my ($class, %opts) = @_;
    return bless \%opts, $class;
}

sub process {
    my ($self, $data) = @_;
    die "No data provided" unless $data;
    my @results;
    for my $item (@$data) {
        push @results, $self->_transform($item);
    }
    return \@results;
}

sub _transform {
    my ($self, $item) = @_;
    return uc($item);
}

1;
END_CODE

{
    desc => q{Solarized + Perl},
    description => <<'END_DESC',
Theme: solarized + language: perl

Visual checks:
- Solarized color scheme with Perl syntax highlighting
- Standard Solarized keyword/string/comment colors applied
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('solarized');
        $ctx->editor->set_language('perl');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot();
    },
}
