my $CODE = <<'END_CODE';
Hello World
END_CODE

{
    desc => q{X deletes character before cursor},
    description => <<'END_DESC',
Action: `X` deletes the character before (to the left of) the cursor

Macro: `xt/visual/macros/delete_before_X`

**initial.png** (before):
- Line 1: `Hello World`
- Cursor at line 1, col 0

Keys: `5lX`

**after_X.png** (after):
- Line 1: `Hell World` (`o` at col 4 deleted)
- Cursor at line 1, col 4 (on the space)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('5lX');
        $ctx->delay(100);
        $ctx->snapshot('after_X');
    },
}
