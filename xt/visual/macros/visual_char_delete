my $CODE = <<'END_CODE';
hello world this is a test
line two
line three
END_CODE

{
    desc => q{Visual char delete},
    description => <<'END_DESC',
Action: v selects chars, d deletes selection

_1.png (initial state):
- Normal mode, cursor at line 1, col 0

Action: keystrokes "vllld" (select 4 chars, delete)

_2.png (after action):
- "hell" deleted from line 1: "o world this is a test"
- Mode back to NORMAL
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('vllld');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
