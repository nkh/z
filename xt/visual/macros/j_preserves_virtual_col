my $CODE = <<'END_CODE';
short
a much longer line here
tiny
another very long line to test column preservation
END_CODE

{
    desc => q{j preserves virtual column},
    description => <<'END_DESC',
Action: Move to end of long line, j preserves desired column

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "jj$" (move to long line, then end of line, then down)

_2.png (after action):
- Cursor on line 3 ("tiny") which is shorter
- Virtual column preserved (cursor at end of line 3)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('jj$j');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
