my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => q{:set theme=dark},
    description => <<'END_DESC',
Action: :set theme=dark switches to dark theme

_1.png (initial state):
- Default (light) theme

Action: ex command ":set theme=dark"

_2.png (after action):
- Dark theme applied (#1E1E1E background)
- Text colors changed for dark background
- Status bar colors updated
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('default');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->ex('set theme=dark');
        $ctx->delay(200);
        $ctx->snapshot('2');
    },
}
