my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => q{Undo restores deleted char},
    description => <<'END_DESC',
Action: x deletes char, u restores it

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "xxu" (delete 2 chars, undo 1)

_2.png (after action):
- Line 1 starts with "ine one" (1 char deleted, 1 restored)
- Cursor at line 1, col 0
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('xxu');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
