my $CODE = <<'END_CODE';
hello world this is a test
line two
END_CODE

{
    desc => q{Delete word dw},
    description => <<'END_DESC',
Action: dw deletes word under cursor

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "dw" (delete word)

_2.png (after action):
- "hello " deleted, line 1 now starts with "world this is a test"
- Cursor at line 1, col 0
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('dw');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
