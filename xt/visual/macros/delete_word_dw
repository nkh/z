my $CODE = <<'END_CODE';
hello world test
END_CODE

{
    desc => q{dw deletes word},
    description => <<'END_DESC',
Action: `dw` deletes the word under the cursor (including trailing space)

Macro: `xt/visual/macros/delete_word_dw`

**initial.png** (before):
- Line 1: `hello world test`
- Cursor at line 1, col 0 (start of `hello`)

Keys: `dw`

**after_dw.png** (after):
- Line 1: `world test` (`hello ` deleted)
- Cursor at line 1, col 0 (start of `world`)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('dw');
        $ctx->delay(100);
        $ctx->snapshot('after_dw');
    },
}
