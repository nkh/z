my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => q{:set tabstop=0 rejected},
    description => <<'END_DESC',
Action: :set tabstop=0 shows error (invalid value)

_1.png (initial state):
- Normal mode

Action: ex command ":set tabstop=0"

_2.png (after action):
- Error message for invalid tabstop value
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->ex('set tabstop=0');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
