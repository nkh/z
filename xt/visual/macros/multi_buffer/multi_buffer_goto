{
    desc => q{:b<N> jumps directly to a buffer by index number},
    description => <<'END_DESC',
## Macro: `xt/visual/macros/multi_buffer/multi_buffer_goto`

Tests that `:b<N>` (buffer goto) switches directly to the buffer at the
given index number without cycling through intermediate buffers.

Setup: Open two temporary files via `:e`, navigate to buffer 1, then run
`:b2`.

Ex: `:b2`

- **multi_buffer_goto_on_buffer_one.png**: Editor showing the content of
  buffer 1 ("First file") with cursor in NORMAL mode.
- **multi_buffer_goto_on_buffer_two.png**: After `:b2`, the editor displays
  buffer 2 ("Second file") directly, without cycling.
END_DESC
    run => sub {
        my ($ctx) = @_;

        # Create two temporary files
        require File::Temp;
        my ($fh1, $f1) = File::Temp::tempfile(SUFFIX => '.txt', UNLINK => 1, DIR => '/tmp');
        print $fh1 "First file - buffer 1\nLine 2 of buffer 1\nLine 3 of buffer 1\n";
        close $fh1;

        my ($fh2, $f2) = File::Temp::tempfile(SUFFIX => '.txt', UNLINK => 1, DIR => '/tmp');
        print $fh2 "Second file - buffer 2\nLine 2 of buffer 2\n";
        close $fh2;

        # Open both files
        $ctx->ex("e $f1");
        $ctx->delay(200);
        $ctx->ex("e $f2");
        $ctx->delay(200);

        # Go back to buffer 1
        $ctx->ex('bp');
        $ctx->delay(200);

        # We're on buffer 1 - snapshot shows buffer 1 content
        $ctx->snapshot('on_buffer_one');

        # Jump directly to buffer 2
        $ctx->ex('b2');
        $ctx->delay(200);
        $ctx->snapshot('on_buffer_two');
    },
}
