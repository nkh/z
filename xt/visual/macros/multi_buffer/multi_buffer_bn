{
    desc => q{:bn switches to next buffer in the buffer list},
    description => <<'END_DESC',
# multi_buffer_bn, :bn switches to next buffer in the buffer list

Macro: `xt/visual/macros/multi_buffer/multi_buffer_bn`

(Multi-buffer test — creates temporary files in run sub)

## on_buffer_two.png

- Keys    : :e`Space` $f1 :e`Space` $f2

## after_switch.png

- Keys    : :bn


END_DESC
    run => sub {
        my ($ctx) = @_;

        # Create two temporary files
        require File::Temp;
        my ($fh1, $f1) = File::Temp::tempfile(SUFFIX => '.txt', UNLINK => 1, DIR => '/tmp');
        print $fh1 "First file - buffer 1\nLine 2 of buffer 1\nLine 3 of buffer 1\n";
        close $fh1;

        my ($fh2, $f2) = File::Temp::tempfile(SUFFIX => '.txt', UNLINK => 1, DIR => '/tmp');
        print $fh2 "Second file - buffer 2\nLine 2 of buffer 2\n";
        close $fh2;

        # Open both files
        $ctx->ex("e $f1");
        $ctx->delay(200);
        $ctx->ex("e $f2");
        $ctx->delay(200);

        # We're now on buffer 2 - snapshot shows buffer 2 content
        $ctx->snapshot('on_buffer_two');

        # Switch to next buffer (wraps to buffer 1)
        $ctx->ex('bn');
        $ctx->delay(200);
        $ctx->snapshot('after_switch');
    },
}
