{
    desc => ':bn switches to next buffer in the buffer list',
    description => <<'END_DESC',
Macro: `xt/visual/macros/multi_buffer_bn`

Tests that `:bn` (buffer next) cycles forward through the buffer registry,
wrapping from the last buffer back to the first.

Setup: Open two temporary files via `:e`, so the buffer list contains two
entries. Navigate to buffer 2, then run `:bn`.

Ex: `:bn`

- **multi_buffer_bn_on_buffer_two.png**: Editor showing the content of
  buffer 2 ("Second file") with cursor in NORMAL mode.
- **multi_buffer_bn_after_switch.png**: After `:bn`, the editor displays
  buffer 1 ("First file"), having wrapped from the end of the buffer list.
END_DESC
    run => sub {
        my ($ctx) = @_;

        # Create two temporary files
        require File::Temp;
        my ($fh1, $f1) = File::Temp::tempfile(SUFFIX => '.txt', UNLINK => 1, DIR => '/tmp');
        print $fh1 "First file - buffer 1\nLine 2 of buffer 1\nLine 3 of buffer 1\n";
        close $fh1;

        my ($fh2, $f2) = File::Temp::tempfile(SUFFIX => '.txt', UNLINK => 1, DIR => '/tmp');
        print $fh2 "Second file - buffer 2\nLine 2 of buffer 2\n";
        close $fh2;

        # Open both files
        $ctx->ex("e $f1");
        $ctx->delay(200);
        $ctx->ex("e $f2");
        $ctx->delay(200);

        # We're now on buffer 2 - snapshot shows buffer 2 content
        $ctx->snapshot('on_buffer_two');

        # Switch to next buffer (wraps to buffer 1)
        $ctx->ex('bn');
        $ctx->delay(200);
        $ctx->snapshot('after_switch');
    },
}
