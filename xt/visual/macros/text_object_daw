my $CODE = <<'END_CODE';
hello   world   this
END_CODE

{
    desc => 'daw deletes a word with surrounding whitespace',
    description => <<'END_DESC',
Macro: `xt/visual/macros/text_object_daw`

Tests the `daw` text object which deletes the word under the cursor
including trailing whitespace.

**initial.png** — Cursor on 'h' of `hello` at line 1 col 0.

Keys: `daw`

**after_daw.png** — The word `hello` plus trailing spaces are removed.
Line 1 now reads `world   this`. Cursor at col 0.
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('daw');
        $ctx->delay(100);
        $ctx->snapshot('after_daw');
    },
}
