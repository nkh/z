my $CODE = <<'END_CODE';
abracadabra
line two
END_CODE

{
    desc => q{Count find backward 3F},
    description => <<'END_DESC',
Action: 3F finds 3rd occurrence backward

_1.png (initial state):
- Cursor at line 1, col 10 (last char)

Action: keystrokes "$3Fa" (EOL, find 3rd 'a' backward)

_2.png (after action):
- Cursor on 3rd 'a' from end (col 5 in "abracadabra")
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('$3Fa');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
