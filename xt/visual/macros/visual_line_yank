my $CODE = <<'END_CODE';
line one
line two
line three
line four
END_CODE

{
    desc => q{Visual line yank},
    description => <<'END_DESC',
Action: V selects lines, y yanks (no text change)

_1.png (initial state):
- Cursor at line 1

Action: keystrokes "Vjy" (select 2 lines, yank)

_2.png (after action):
- Text unchanged
- Mode back to NORMAL
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('Vjy');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
