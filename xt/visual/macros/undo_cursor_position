my $CODE = <<'END_CODE';
line one
line two
line three
line four
END_CODE

{
    desc => q{Undo restores cursor position},
    description => <<'END_DESC',
Action: dd deletes line, u restores line and cursor position

_1.png (initial state):
- Cursor at line 2

Action: keystrokes "jddu" (move, delete, undo)

_2.png (after action):
- Original line 2 restored
- Cursor returns to original position (line 2)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->keys('j');
        $ctx->delay(50);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('ddu');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
