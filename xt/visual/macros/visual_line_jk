my $CODE = <<'END_CODE';
hello world this is
line two
END_CODE

{
    desc => q{Visual line j/k navigation},
    description => <<'END_DESC',
Action: V enters visual line mode, j/k extends

_1.png (initial state):
- Cursor at line 1

Action: keystrokes "Vjj" (visual line, move down 2)

_2.png (after action):
- 3 lines selected
- Mode label: "-- VISUAL LINE --"
- Full line widths highlighted
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('Vjj');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
