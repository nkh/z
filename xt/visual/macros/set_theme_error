my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => q{:set theme= unknown error},
    description => <<'END_DESC',
Action: :set theme= with unknown theme shows error

_1.png (initial state):
- Normal mode

Action: ex command ":set theme=nonexistent"

_2.png (after action):
- Error message for unknown theme
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->ex('set theme=nonexistent');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
