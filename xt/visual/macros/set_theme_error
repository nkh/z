my $CODE = <<'END_CODE';
# Theme switch test
Hello, World!
my $x = 42;
print "dark mode\n";
END_CODE

{
    desc => ':set theme=nonexistent shows an error for unknown theme names',
    description => <<'END_DESC',
Macro: `xt/visual/macros/set_theme_error`

Tests that `:set theme=` with a nonexistent theme name displays an error
message and does not change the current theme.

Starts from the dark theme to ensure the error is visible against a known
background.

Ex: `:set theme=nonexistent`

- **set_theme_error_dark_before.png**: Dark theme active, normal editing
  state before the invalid command.
- **set_theme_error_message.png**: Error message displayed in the status
  area indicating the theme name was not recognized; the dark theme
  remains unchanged.
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('dark_before');
        $ctx->delay(100);
        $ctx->ex('set theme=nonexistent');
        $ctx->delay(100);
        $ctx->snapshot('message');
    },
}
