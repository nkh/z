{
    desc => q{L moves cursor to bottom of viewport},
    description => <<'END_DESC',
Macro: `xt/visual/macros/viewport_L`

Tests that `L` jumps the cursor to the last visible line of the current viewport. The buffer has 40 lines; `G` scrolls to bottom, then `k` moves up one so L can jump back to the bottom.

Keys: `G` → `k` → `L`

- **viewport_L_initial.png**: Cursor at line 1, col 0 on "viewport line 01"
- **viewport_L_at_bottom.png**: Cursor at line 40 after `G`; viewport scrolled to bottom
- **viewport_L_after_k.png**: Cursor at line 39 after `k` (one line up from bottom)
- **viewport_L_after_L.png**: Cursor back on the last visible line of the viewport (bottom)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('G');
        $ctx->delay(200);
        $ctx->snapshot('at_bottom');
        $ctx->delay(100);
        $ctx->keys('k');
        $ctx->delay(200);
        $ctx->snapshot('after_k');
        $ctx->delay(100);
        $ctx->keys('L');
        $ctx->delay(200);
        $ctx->snapshot('after_L');
    },
}
