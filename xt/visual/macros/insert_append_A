my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => q{Append at end of line A},
    description => <<'END_DESC',
Action: A moves to end of line and enters insert mode

_1.png (initial state):
- Normal mode, cursor at line 1, col 0

Action: keystrokes "AXXEscape" (append at EOL)

_2.png (after action):
- Line 1 ends with "line oneXX"
- Cursor before the XX
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->key('A');
        $ctx->type('XX');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
