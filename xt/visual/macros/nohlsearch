my $CODE = <<'END_CODE';
hello world hello
hello again world
END_CODE

{
    desc => q{:nohlsearch clears highlights},
    description => <<'END_DESC',
Action: /hello highlights matches, :nohlsearch clears them

_1.png (initial state):
- Normal mode

Action: keystrokes "/helloReturn" then ex ":nohlsearch"

_2.png (after action):
- Search highlights cleared
- Mode label: "-- NORMAL --"
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('/hello\\n');
        $ctx->delay(300);
        $ctx->ex('nohlsearch');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
