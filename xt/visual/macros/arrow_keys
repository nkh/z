my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => q{Arrow key navigation},
    description => <<'END_DESC',
Action: Down arrow moves cursor down

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "Down" (arrow key down)

_2.png (after action):
- Cursor at line 2, col 0
- No text content change
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->key('Down');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
