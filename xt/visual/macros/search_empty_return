my $CODE = <<'END_CODE';
hello world
line two
line three
END_CODE

{
    desc => '/ with Return on empty pattern shows error',
    description => <<'END_DESC',
Action: / then Return with no pattern typed

_1.png (initial state):
- Normal mode, cursor at line 1, col 0

Action: keystrokes "/Return" (search with empty pattern)

_2.png (after action):
- Mode label shows error: "Error: Empty search pattern"
- Buffer unchanged
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('/\n');
        $ctx->delay(300);
        $ctx->snapshot('2');
    },
}
