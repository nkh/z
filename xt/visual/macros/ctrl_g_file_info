my $CODE = <<'END_CODE';
hello world
foo bar baz
END_CODE

{
    desc => 'Ctrl-G shows file info in the status bar',
    description => <<'END_DESC',
Macro: `xt/visual/macros/ctrl_g_file_info`

Tests that `Ctrl-g` displays file information in the status/mode label,
including the filename, total line count, and cursor position.

Keys: `Ctrl-g`

- **ctrl_g_file_info_initial.png**: Normal mode, cursor at line 1 col 0.
- **ctrl_g_file_info_after_ctrl_g.png**: Mode label shows file info (e.g. filename, line count, percentage through file).
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('Control-g');
        $ctx->delay(200);
        $ctx->snapshot('after_ctrl_g');
    },
}
