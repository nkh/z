my $CODE = <<'END_CODE';
hello
world
this is a test
END_CODE

{
    desc => q{Join lines J},
    description => <<'END_DESC',
Action: J joins current line with next

_1.png (initial state):
- Cursor at line 1

Action: keystrokes "J" (join with next line)

_2.png (after action):
- Line 1 and line 2 joined: "hello world"
- Line 3 becomes line 2
- Buffer now has 2 lines
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('J');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
