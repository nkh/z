my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => q{Open line above O},
    description => <<'END_DESC',
Action: O opens new line above and enters insert mode

_1.png (initial state):
- Normal mode, cursor at line 2

Action: keystrokes "Onew lineEscape" (open above, type, exit)

_2.png (after action):
- New line "new line" inserted before line 2
- Buffer now has 4 lines
- Cursor on the new line (line 2)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->keys('j');
        $ctx->delay(50);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->key('O');
        $ctx->type('new line');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
