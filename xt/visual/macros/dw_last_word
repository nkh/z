my $CODE = <<'END_CODE';
hello world this is
line two
END_CODE

{
    desc => q{dw at last word},
    description => <<'END_DESC',
Action: dw at last word on line

_1.png (initial state):
- Cursor at line 1, col 16 (start of "is")

Action: keystrokes "wwdw" (move to last word, delete it)

_2.png (after action):
- "is" deleted, trailing space remains: "hello world this "
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('wwdw');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
