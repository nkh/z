{
    desc => q{o opens a new line below and enters insert mode},
    description => <<'END_DESC',
# insert_open_o, o opens a new line below and enters insert mode

Macro: `xt/visual/macros/editing/insert_open_o`

## initial.png

- Cursor: 1, 0
- Line 1  : line one
- Line 2  : line two

## after_open_below.png



END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->key('o');
        $ctx->type('inserted line');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('after_open_below');
    },
}
