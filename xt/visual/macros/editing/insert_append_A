{
    desc => q{A appends text at end of line},
    description => <<'END_DESC',
# insert_append_A, A appends text at end of line

Macro: `xt/visual/macros/editing/insert_append_A`

## initial.png

- Cursor: 1, 0
- Line 1  : Hello world

## after_append_to_eol.png



END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->key('A');
        $ctx->type('!');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('after_append_to_eol');
    },
}
