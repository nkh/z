{
    desc => q{S substitutes entire line},
    description => <<'END_DESC',
# substitute_line_S, S substitutes entire line

Macro: `xt/visual/macros/editing/substitute_line_S`

## initial.png

- Cursor: 1, 0
- Line 1  : line one
- Line 2  : line two
- Line 3  : line three

## after_S.png

- Keys    : jS


END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('jS');
        $ctx->delay(50);
        $ctx->type('new content');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('after_S');
    },
}
__DATA__
line one
line two
line three
