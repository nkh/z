    desc => q{xp swaps the character under cursor with the next character},
    description => <<'END_DESC',
# swap_chars_xp, xp swaps the character under cursor with the next character

Macro: `xt/visual/macros/editing/swap_chars_xp`

## initial.png

- Cursor: 1, 0
- Line 1  : This is a longer line of text for testing.
- Line 2  : The quick brown fox jumps over the lazy dog.
- Line 3  : Another line here to fill the buffer.
- Line 4  : And yet another line for scrolling context.
- Line 5  : Final line of the test buffer content.

## after_swap.png

- Keys    : l xp


END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('l');
        $ctx->delay(50);
        $ctx->keys('xp');
        $ctx->delay(100);
        $ctx->snapshot('after_swap');
    },
}
