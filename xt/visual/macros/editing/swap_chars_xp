    desc => q{xp swaps the character under cursor with the next character},
    description => <<'END_DESC',
## Macro: `xt/visual/macros/swap_chars_xp`

Tests the common **xp** idiom for transposing two characters:
**x** deletes the character under the cursor (storing it), then
**p** pastes it after the current cursor position, effectively swapping
two adjacent characters.

**Keys:** `l`, `xp`

**initial.png**
- Buffer contains "abcdef"
- Cursor on 'a' at column 0

**after_swap.png**
- Buffer contains "acbdef" ('b' and 'c' swapped)
- Cursor on 'c' at column 2
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('l');
        $ctx->delay(50);
        $ctx->keys('xp');
        $ctx->delay(100);
        $ctx->snapshot('after_swap');
    },
}
