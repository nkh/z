{
    desc => q{O opens a new line above and enters insert mode},
    description => <<'END_DESC',
# insert_open_O, O opens a new line above and enters insert mode

Macro: `xt/visual/macros/editing/insert_open_O`

## initial.png

- Cursor: 1, 0
- Line 1  : line one
- Line 2  : line two

## after_open_above.png



END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->keys('j');
        $ctx->delay(50);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->key('O');
        $ctx->type('inserted line');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('after_open_above');
    },
}
