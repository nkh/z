{
    desc => q{dw on last word of line},
    description => <<'END_DESC',
Action: `dw` on the last word of a line deletes it without trailing whitespace

Macro: `xt/visual/macros/dw_last_word`

**initial.png** (before):
- Line 1: `hello world test`
- Cursor at line 1, col 0

Keys: `wwdw`

**after_dw_last.png** (after):
- Line 1: `hello world ` (`test` deleted, trailing space preserved)
- Cursor at end of line
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('wwdw');
        $ctx->delay(100);
        $ctx->snapshot('after_dw_last');
    },
}
