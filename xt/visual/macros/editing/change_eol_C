    desc => q{C changes to end of line},
    description => <<'END_DESC',
# change_eol_C, C changes to end of line

Macro: `xt/visual/macros/editing/change_eol_C`

## initial.png

- Cursor: 1, 0
- Line 1  : This is a first line of text in the buffer.
- Line 2  : Here is a second line with more content.
- Line 3  : Third line with some additional words here.
- Line 4  : Fourth line to provide scrolling context.
- Line 5  : Fifth line at the bottom of the buffer.

## after_C.png

- Keys    : 6lC


END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('6lC');
        $ctx->delay(50);
        $ctx->type('DONE');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('after_C');
    },
}
