{
    desc => 'read-only mode blocks editing',
    description => <<'END_DESC',
# readonly_blocks_edit, read-only mode blocks editing

Macro: `xt/visual/macros/editing/readonly_blocks_edit`

## initial.png

- Cursor: 1, 0
- Line 1  : do not modify me

## after_blocked_edit.png



END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        # Set readonly at the Vim bindings level so insert/replace mode
        # transitions are blocked by the mode setter.
        my $vim_ctx = $ctx->editor->get_vim_ctx;
        $vim_ctx->{is_readonly} = 1;
        $ctx->delay(50);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->key('i');
        $ctx->type('NOPE');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('after_blocked_edit');
    },
}
