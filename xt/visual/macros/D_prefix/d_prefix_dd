{
    desc => q{dd deletes current line},
    description => <<'END_DESC',
Action: `dd` deletes the current line entirely

Macro: `xt/visual/macros/d_prefix_dd`

**initial.png** (before):
- Line 1: `line one`
- Line 2: `line two`
- Line 3: `line three`
- Cursor at line 1, col 0

Keys: `jdd`

**after_dd.png** (after):
- Line 1: `line one`
- Line 2: `line three`
- Cursor at line 2, col 0 (was `line two`, now deleted)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('jdd');
        $ctx->delay(100);
        $ctx->snapshot('after_dd');
    },
}
