my $CODE = <<'END_CODE';
Hello world
foo bar
END_CODE

{
    desc => q{Backspace key in normal mode},
    description => <<'END_DESC',
Macro: `xt/visual/macros/delete_backward`

Tests that the Backspace key in normal mode moves the cursor left (behaves like `h`). At column 0, Backspace should be a no-op.

Keys: `l` → `l` → `Backspace` → `Backspace` → `Backspace`

- **delete_backward_initial.png**: Cursor at line 1, col 0 on `H` of "Hello"
- **delete_backward_after_ll.png**: Cursor at line 1, col 2 on first `l` of "Hello"
- **delete_backward_after_first_bs.png**: Cursor at line 1, col 1 on `e` of "Hello" (moved left by Backspace)
- **delete_backward_after_second_bs.png**: Cursor at line 1, col 0 on `H` of "Hello" (moved left again)
- **delete_backward_at_col0.png**: Cursor still at line 1, col 0 (Backspace is a no-op at column 0)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('ll');
        $ctx->delay(100);
        $ctx->snapshot('after_ll');
        $ctx->delay(100);
        $ctx->key('BackSpace');
        $ctx->delay(100);
        $ctx->snapshot('after_first_bs');
        $ctx->delay(100);
        $ctx->key('BackSpace');
        $ctx->delay(100);
        $ctx->snapshot('after_second_bs');
        $ctx->delay(100);
        $ctx->key('BackSpace');
        $ctx->delay(100);
        $ctx->snapshot('at_col0');
    },
}
