my $CODE = <<'END_CODE';
line one
line two
line three
line four
line five
END_CODE

{
    desc => q{Count delete 2dd},
    description => <<'END_DESC',
Action: 2dd deletes 2 lines

_1.png (initial state):
- 5 lines of text, cursor at line 1

Action: keystrokes "2dd" (delete 2 lines)

_2.png (after action):
- First 2 lines deleted
- Buffer now has 3 lines starting with "line three"
- Cursor at line 1
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('2dd');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
