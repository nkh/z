my $CODE = <<'END_CODE';
alpha
bravo
charlie
delta
END_CODE

{
    desc => q{2dd deletes 2 lines},
    description => <<'END_DESC',
Action: `2dd` deletes the current line and the next line

Macro: `xt/visual/macros/count_delete_2dd`

**initial.png** (before):
- Line 1: `alpha`
- Line 2: `bravo`
- Line 3: `charlie`
- Line 4: `delta`
- Cursor at line 1, col 0

Keys: `2dd`

**after_2dd.png** (after):
- Line 1: `charlie`
- Line 2: `delta`
- Cursor at line 1, col 0
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('2dd');
        $ctx->delay(100);
        $ctx->snapshot('after_2dd');
    },
}
