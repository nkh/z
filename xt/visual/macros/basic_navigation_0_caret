my $CODE = <<'END_CODE';
  hello world
  foo bar

END_CODE

{
    desc => q{Line start 0 and first-non-blank ^},
    description => <<'END_DESC',
Action: `0` moves to absolute start of line, `^` moves to first non-blank

Macro: `xt/visual/macros/basic_navigation_0_caret`

**initial.png** (before):
- Line 1: `  hello world` (two leading spaces)
- Cursor at line 1, col 0

Keys: `$`

**mid_dollar.png** (after `$`):
- Cursor at line 1, col 12 (on `d`, last character of `world`)
- No text change

Keys: `0`

**after_action.png** (after `0`):
- Cursor at line 1, col 0 (absolute start of line)
- No text change

END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('$');
        $ctx->delay(100);
        $ctx->snapshot('mid_dollar');
        $ctx->delay(100);
        $ctx->keys('0');
        $ctx->delay(100);
        $ctx->snapshot('after_action');
    },
}
