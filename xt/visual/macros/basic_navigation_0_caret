my $CODE = <<'END_CODE';
    indented line one
    indented line two
short line
END_CODE

{
    desc => q{Line start 0 and first-non-blank ^},
    description => <<'END_DESC',
Action: 0 and ^ line motions

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "$0" (end of line, then line start)

_2.png (after action):
- Cursor at line 1, col 0 (absolute start of line)
- No text change
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('$0');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
