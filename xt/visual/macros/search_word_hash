my $CODE = <<'END_CODE';
hello world hello again
foo bar baz hello
END_CODE

{
    desc => q{# searches backward for word under cursor},
    description => <<'END_DESC',
Action: # searches backward for the word under the cursor

_1.png (initial state):
- Dark theme with 2 lines
- Cursor at line 2, col 12 (on 'h' of 'hello' on line 2)

Action: move to "hello" on line 2 first, then press "#"

_2.png (after action):
- All occurrences of "hello" highlighted
- Cursor moved to previous occurrence of "hello" on line 1
- Search pattern set to "hello", direction backward
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('$hhhh#');
        $ctx->delay(300);
        $ctx->snapshot('2');
    },
}
