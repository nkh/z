my $CODE = <<'END_CODE';
hello world
line two
END_CODE

{
    desc => 'Undo after replace mode restores original text',
    description => <<'END_DESC',
Action: R replace chars, Escape, u restores original

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "RXXXX\\eu" (replace 4 chars, undo)

_2.png (after action):
- "XXXX" replacement undone
- Line 1 restored to original "hello world"
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('RXXXX');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->keys('u');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
