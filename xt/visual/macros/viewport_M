{
    desc => q{Viewport M (middle of viewport)},
    description => <<'END_DESC',
Action: M moves cursor to middle of viewport

_1.png (initial state):
- Cursor at line 1

Action: keystrokes "GM" (go to bottom, then M to middle)

_2.png (after action):
- Cursor on middle line of visible viewport
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('GM');
        $ctx->delay(200);
        $ctx->snapshot('2');
    },
}
