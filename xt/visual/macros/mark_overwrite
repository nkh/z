my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => 'Overwrite existing mark then jump to it',
    description => <<'END_DESC',
Action: Set mark a, move, overwrite mark a, jump back

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "makkjjjma`a" (set mark a on line 1, move to line 3, overwrite mark a, jump back)

_2.png (after action):
- Cursor at line 3, col 0 (jumped to overwritten mark a position)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('ma');
        $ctx->delay(50);
        $ctx->keys('kk');
        $ctx->delay(50);
        $ctx->keys('jjj');
        $ctx->delay(50);
        $ctx->keys('ma');
        $ctx->delay(50);
        $ctx->keys('`a');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
