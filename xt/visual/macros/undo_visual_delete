my $CODE = <<'END_CODE';
hello world
line two
END_CODE

{
    desc => q{Undo after visual delete},
    description => <<'END_DESC',
Action: Visual select and delete, then undo

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "vllldu" (select 4 chars, delete, undo)

_2.png (after action):
- Original text restored by undo
- Line 1 back to "hello world"
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('vllldu');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
