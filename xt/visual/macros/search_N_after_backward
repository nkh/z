my $CODE = <<'END_CODE';
hello world hello
foo bar hello baz
END_CODE

{
    desc => 'N after backward search goes forward',
    description => <<'END_DESC',
Action: ?hello searches backward, N repeats in opposite (forward) direction

_1.png (initial state):
- Cursor at line 2, col 0

Action: keystrokes "?hello\\nn" (backward search, then N goes forward)

_2.png (after action):
- After ?hello: cursor on "hello" on line 1
- After N: cursor moves forward to next "hello" on line 1
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('?hello\n');
        $ctx->delay(300);
        $ctx->keys('N');
        $ctx->delay(200);
        $ctx->snapshot('2');
    },
}
