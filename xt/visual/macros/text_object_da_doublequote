my $CODE = <<'END_CODE';
say("hello world");
END_CODE

{
    desc => q{da" deletes text including surrounding double quotes},
    description => <<'END_DESC',
Macro: `xt/visual/macros/text_object_da_doublequote`

Tests the `da"` text object which deletes text **including** the
double quote delimiters themselves.

**initial.png** — Cursor on 'h' inside the double quotes at line 1 col 5.

Keys: `da"`

**after_da_doublequote.png** — The entire `"hello world"` including both
double quotes is removed. Line 1 now reads `say();`.
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_language('perl');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('llll');
        $ctx->delay(50);
        $ctx->keys('da"');
        $ctx->delay(100);
        $ctx->snapshot('after_da_doublequote');
    },
}
