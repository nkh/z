my $CODE = <<'END_CODE';
abcd
efgh
ijkl
mnop
END_CODE

{
    desc => q{Visual block yank},
    description => <<'END_DESC',
Action: Ctrl-V selects block, y yanks (no text change)

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "Control-vjjly" (block select 3 rows x 2 cols, yank)

_2.png (after action):
- Text unchanged (yank does not modify buffer)
- Mode back to NORMAL
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('Control-vjjly');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
