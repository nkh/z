my $CODE = <<'END_CODE';
arr[0] = items[idx]
line two
END_CODE

{
    desc => q{Bracket match % square brackets},
    description => <<'END_DESC',
Action: % jumps to matching square bracket

_1.png (initial state):
- Cursor at line 1, col 3 (on first '[')

Action: keystrokes "3l%" (move to '[', match)

_2.png (after action):
- Cursor on matching ']' after "0"
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('3l%');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
