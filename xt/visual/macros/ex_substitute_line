my $CODE = <<'END_CODE';
hello world hello again
foo bar baz hello
END_CODE

{
    desc => ':s/pat/repl/ substitutes first occurrence on current line',
    description => <<'END_DESC',
Action: :s/pat/repl/ replaces first match on current line

_1.png (initial state):
- Cursor at line 1, col 0

Action: ex command ":s/hello/HI/"

_2.png (after action):
- First "hello" on line 1 replaced with "HI"
- Line 1: "HI world hello again"
- Second "hello" on same line NOT replaced (first occurrence only)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->ex('s/hello/HI/');
        $ctx->delay(200);
        $ctx->snapshot('2');
    },
}
