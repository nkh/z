my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => q{Substitute line S},
    description => <<'END_DESC',
Action: S deletes line content and enters insert mode

_1.png (initial state):
- Cursor at line 2

Action: keystrokes "jSnew lineEscape" (substitute line)

_2.png (after action):
- Line 2 replaced with "new line"
- Lines 1 and 3 unchanged
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->keys('j');
        $ctx->delay(50);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('S');
        $ctx->delay(50);
        $ctx->type('new line');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
