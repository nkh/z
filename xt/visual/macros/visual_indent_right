my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => q{Visual indent right >>},
    description => <<'END_DESC',
Action: V selects lines, >> indents them

_1.png (initial state):
- Cursor at line 1

Action: keystrokes "Vj>>" (select 2 lines, indent)

_2.png (after action):
- First 2 lines indented
- Line 3 unchanged
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('Vj>>');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
