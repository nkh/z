my $CODE = <<'END_CODE';
not on a bracket
line two
END_CODE

{
    desc => q{Percent not on bracket scans forward},
    description => <<'END_DESC',
Action: % when not on a bracket scans forward to find one

_1.png (initial state):
- Cursor at line 1, col 0 (not on any bracket)

Action: keystrokes "%" (scan forward for bracket)

_2.png (after action):
- % scans forward to find next bracket character
- Cursor may move or stay depending on buffer content
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('%');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
