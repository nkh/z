my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => q{Undo 2dd restores both},
    description => <<'END_DESC',
Action: 2dd deletes 2 lines, u restores both

_1.png (initial state):
- 3 lines, cursor at line 1

Action: keystrokes "2ddu" (delete 2 lines, undo)

_2.png (after action):
- Both lines restored
- Original 3 lines intact
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('2ddu');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
