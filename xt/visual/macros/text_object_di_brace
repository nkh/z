my $CODE = <<'END_CODE';
func({key => "value"});
my %hash = (a => 1);
END_CODE

{
    desc => 'di{ deletes text inside curly braces',
    description => <<'END_DESC',
Action: di{ deletes text inside the nearest curly braces

_1.png (initial state):
- Cursor at line 1, col 6 (on '{' character)

Action: keystrokes "di{" (delete inner braces)

_2.png (after action):
- Text between { and } deleted, braces remain
- Line 1 now: 'func({});'
- Cursor at line 1, col 6
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->editor->set_language('perl');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('llllll');
        $ctx->delay(50);
        $ctx->keys('di{');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
