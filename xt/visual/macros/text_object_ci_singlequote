my $CODE = <<'END_CODE';
my $x = "hello";
my $y = 'world';
my $z = ($x + $y);
END_CODE

{
    desc => 'ci\' changes text inside single quotes',
    description => <<'END_DESC',
Action: ci' deletes text inside single quotes and enters insert mode

_1.png (initial state):
- Cursor at line 2, col 10 (on 'w' inside quotes)

Action: keystrokes "ci'REPLACED\\e" (change inner single quotes)

_2.png (after action):
- Text between quotes changed to "REPLACED"
- Line 2: "my \$y = 'REPLACED';"
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->editor->set_language('perl');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('jllllllllll');
        $ctx->delay(50);
        $ctx->keys("ci'");
        $ctx->delay(50);
        $ctx->type('REPLACED');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
