{
    desc => ':bp switches to previous buffer in the buffer list',
    description => <<'END_DESC',
Macro: `xt/visual/macros/multi_buffer_bp`

Tests that `:bp` (buffer previous) cycles backward through the buffer
registry, wrapping from the first buffer back to the last.

Setup: Open two temporary files via `:e`, navigate to buffer 1, then run
`:bp`.

Ex: `:bp`

- **multi_buffer_bp_on_buffer_one.png**: Editor showing the content of
  buffer 1 ("First file") with cursor in NORMAL mode.
- **multi_buffer_bp_after_switch.png**: After `:bp`, the editor displays
  buffer 2 ("Second file"), having wrapped from the start of the buffer list.
END_DESC
    run => sub {
        my ($ctx) = @_;

        # Create two temporary files
        require File::Temp;
        my ($fh1, $f1) = File::Temp::tempfile(SUFFIX => '.txt', UNLINK => 1, DIR => '/tmp');
        print $fh1 "First file - buffer 1\nLine 2 of buffer 1\nLine 3 of buffer 1\n";
        close $fh1;

        my ($fh2, $f2) = File::Temp::tempfile(SUFFIX => '.txt', UNLINK => 1, DIR => '/tmp');
        print $fh2 "Second file - buffer 2\nLine 2 of buffer 2\n";
        close $fh2;

        # Open both files
        $ctx->ex("e $f1");
        $ctx->delay(200);
        $ctx->ex("e $f2");
        $ctx->delay(200);

        # Go back to buffer 1 first
        $ctx->ex('bp');
        $ctx->delay(200);

        # We're now on buffer 1 - snapshot shows buffer 1 content
        $ctx->snapshot('on_buffer_one');

        # Switch to previous buffer (wraps to buffer 2)
        $ctx->ex('bp');
        $ctx->delay(200);
        $ctx->snapshot('after_switch');
    },
}
