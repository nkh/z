my $CODE = <<'END_CODE';
hello world
hello again
goodbye world
END_CODE

{
    desc => q{Search repeat N backward},
    description => <<'END_DESC',
Action: N repeats search backward

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "/worldReturnN" (search forward, then N backward)

_2.png (after action):
- First /world matches on line 1
- N goes backward (wraps to line 3 "world")
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('/world\\nN');
        $ctx->delay(300);
        $ctx->snapshot('2');
    },
}
