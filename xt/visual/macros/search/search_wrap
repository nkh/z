{
    desc => q{Search wraps around the end of the buffer},
    description => <<'END_DESC',
# search_wrap, Search wraps around the end of the buffer

Macro: `xt/visual/macros/search/search_wrap`

## initial.png

- Cursor: 1, 0
- Line 1  : alpha beta
- Line 2  : gamma alpha
- Line 3  : delta epsilon

## after_first_search.png

- Keys    : /alpha `Enter`

## after_first_n.png

- Keys    : n

## after_wrap_n.png

- Keys    : n


END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('/alpha\n');
        $ctx->delay(300);
        $ctx->snapshot('after_first_search');
        $ctx->delay(100);
        $ctx->keys('n');
        $ctx->delay(200);
        $ctx->snapshot('after_first_n');
        $ctx->delay(100);
        $ctx->keys('n');
        $ctx->delay(200);
        $ctx->snapshot('after_wrap_n');
    },
}
__DATA__
alpha beta
gamma alpha
delta epsilon
