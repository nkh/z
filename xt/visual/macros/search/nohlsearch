{
    desc => q{:nohlsearch clears search highlights},
    description => <<'END_DESC',
# nohlsearch, :nohlsearch clears search highlights

Macro: `xt/visual/macros/search/nohlsearch`

## initial.png

- Cursor: 1, 0
- Line 1  : foo bar foo baz foo

## after_search.png

- Keys    : /foo `Enter`

## after_nohlsearch.png

- Keys    : :nohlsearch


END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('/foo\n');
        $ctx->delay(300);
        $ctx->snapshot('after_search');
        $ctx->delay(100);
        $ctx->ex('nohlsearch');
        $ctx->delay(100);
        $ctx->snapshot('after_nohlsearch');
    },
}
__DATA__
foo bar foo baz foo
