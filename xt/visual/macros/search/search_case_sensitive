{
    desc => q{Search is case sensitive by default},
    description => <<'END_DESC',
# search_case_sensitive, Search is case sensitive by default

Macro: `xt/visual/macros/search/search_case_sensitive`

## initial.png

- Cursor: 1, 0
- Line 1  : hello world
- Line 2  : Hello world
- Line 3  : hello again

## after_case_search.png

- Keys    : /Hello `Enter`


END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('/Hello\n');
        $ctx->delay(300);
        $ctx->snapshot('after_case_search');
    },
}
