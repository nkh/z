my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => q{Command to Normal via Escape},
    description => <<'END_DESC',
Action: : enters command mode, Escape returns to normal

_1.png (initial state):
- Normal mode

Action: keystrokes ":Escape" (command mode then exit)

_2.png (after action):
- Mode label shows "-- NORMAL --"
- Command entry hidden
- No change to buffer content
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys(':\\e');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
