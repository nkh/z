my $CODE = <<'END_CODE';
my @arr = [1, 2, 3];
END_CODE

{
    desc => 'ci[ changes text inside square brackets',
    description => <<'END_DESC',
Macro: `xt/visual/macros/text_object_ci_bracket`

Tests the `ci[` text object which deletes text inside square brackets,
enters insert mode, then we type replacement text.

**initial.png** — Cursor on '1' inside the brackets at line 1 col 12.

Keys: `ci[` then type `a, b, c` then `<Escape>`

**after_ci_bracket.png** — Content between brackets changed to `a, b, c`.
Line 1 now reads `my @arr = [a, b, c];`. Brackets are preserved.
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_language('perl');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('llllllllllll');
        $ctx->delay(50);
        $ctx->keys('ci[');
        $ctx->delay(50);
        $ctx->type('a, b, c');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('after_ci_bracket');
    },
}
