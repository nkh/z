my $CODE = <<'END_CODE';
my @arr = [$a, $b, $c];
my $x = $arr[0];
END_CODE

{
    desc => 'ci[ changes text inside square brackets',
    description => <<'END_DESC',
Action: ci[ deletes text inside brackets and enters insert mode

_1.png (initial state):
- Cursor at line 1, col 12 (inside brackets)

Action: keystrokes "ci[1, 2, 3\\e" (change inner brackets)

_2.png (after action):
- Text between [ and ] changed to "1, 2, 3"
- Line 1: 'my @arr = [1, 2, 3];'
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->editor->set_language('perl');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('llllllllllll');
        $ctx->delay(50);
        $ctx->keys('ci[');
        $ctx->delay(50);
        $ctx->type('1, 2, 3');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
