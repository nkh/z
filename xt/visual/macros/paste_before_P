my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => q{Paste before P},
    description => <<'END_DESC',
Action: yy yanks line, P pastes above current line

_1.png (initial state):
- Cursor at line 2

Action: keystrokes "jyyP" (yank line 2, paste above)

_2.png (after action):
- Line 2 duplicated above itself
- Buffer now has 4 lines
- Cursor on the pasted copy (line 2)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->keys('j');
        $ctx->delay(50);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('yyP');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
