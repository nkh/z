my $CODE = <<'END_CODE';
hello world this is a test
line two
END_CODE

{
    desc => q{Till char backward T},
    description => <<'END_DESC',
Action: T moves cursor to character after target (backward)

_1.png (initial state):
- Cursor at line 1, col 10

Action: keystrokes "10lTo" (move right, till 'o' backward)

_2.png (after action):
- Cursor one position after 'o' in "hello" (col 5, the space)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('10lTo');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
