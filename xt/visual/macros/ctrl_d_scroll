{
    desc => q{Ctrl-d half-page down},
    description => <<'END_DESC',
Action: Ctrl-d scrolls viewport down by half a page

_1.png (initial state):
- Cursor at line 1, showing first lines

Action: keystrokes "Control-d" (half-page down)

_2.png (after action):
- Viewport scrolled down (approximately half a page)
- Cursor moved down accordingly
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('Control-d');
        $ctx->delay(200);
        $ctx->snapshot('2');
    },
}
