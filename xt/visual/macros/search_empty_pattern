my $CODE = <<'END_CODE';
hello world
line two
END_CODE

{
    desc => q{Search empty pattern error},
    description => <<'END_DESC',
Action: / with empty pattern shows error

_1.png (initial state):
- Normal mode

Action: keystrokes "/Return" (empty search pattern)

_2.png (after action):
- Error message visible: "Pattern not found" or similar
- Cursor unchanged
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('/\\n');
        $ctx->delay(300);
        $ctx->snapshot('2');
    },
}
