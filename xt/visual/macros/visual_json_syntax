my $CODE = <<'END_CODE';
{
    "name": "Gtk3::SourceEditor",
    "version": "0.04",
    "description": "Embeddable Vim-like text editor",
    "dependencies": {
        "Gtk3": "0",
        "Gtk3::SourceView": "0"
    },
    "features": [
        "syntax highlighting",
        "vim keybindings"
    ]
}
END_CODE

{
    desc => q{JSON syntax},
    description => <<'END_DESC',
Syntax highlighting: JSON

Visual checks:
- Keys (in double quotes before colon) colored distinctly from values
- String values have string color
- Numbers have number color
- Braces and brackets may have distinct coloring
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_language('json');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot();
    },
}
