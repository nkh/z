my $CODE = <<'END_CODE';
hello world this is
line two
END_CODE

{
    desc => q{Visual word motion w in visual},
    description => <<'END_DESC',
Action: v enters visual mode, w extends selection by word

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "vww" (visual, move 2 words forward)

_2.png (after action):
- Selection from col 0 to end of second word
- Mode label: "-- VISUAL --"
- "hello world" selected
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('vww');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
