my $CODE = <<'END_CODE';
        line one
        line two
line three
END_CODE

{
    desc => q{Visual unindent left <<},
    description => <<'END_DESC',
Action: V selects lines, << unindents them

_1.png (initial state):
- Lines 1-2 indented, cursor at line 1

Action: keystrokes "Vj<<" (select 2 lines, unindent)

_2.png (after action):
- First 2 lines unindented
- Line 3 unchanged
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('Vj<<');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
