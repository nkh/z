my $CODE = <<'END_CODE';
ABCDEFGHIJ
END_CODE

{
    desc => q{3X deletes 3 characters before cursor},
    description => <<'END_DESC',
Action: `3X` deletes 3 characters before the cursor

Macro: `xt/visual/macros/delete_3X`

**initial.png** (before):
- Line 1: `ABCDEFGHIJ`
- Cursor at line 1, col 0

Keys: `7l3X`

**after_3X.png** (after):
- Line 1: `ABCDHIJ` (`EFG` at cols 4-6 deleted)
- Cursor at line 1, col 4 (on `H`)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('7l3X');
        $ctx->delay(100);
        $ctx->snapshot('after_3X');
    },
}
