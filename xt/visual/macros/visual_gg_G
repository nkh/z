my $CODE = <<'END_CODE';
hello world this is
line two
line three
END_CODE

{
    desc => q{Visual gg/G motions},
    description => <<'END_DESC',
Action: v select, G extends to last line

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "vG" (visual, select to end of buffer)

_2.png (after action):
- Entire buffer selected (all lines)
- Mode label: "-- VISUAL --"
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('vG');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
