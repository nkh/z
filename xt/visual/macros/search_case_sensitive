my $CODE = <<'END_CODE';
hello world hello
foo hello bar
END_CODE

{
    desc => 'Case sensitive search distinguishes Hello from hello',
    description => <<'END_DESC',
Action: /Hello with capital H does not match lowercase hello

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "/Hello\\n" (search for capital H)

_2.png (after action):
- Mode label shows "Pattern not found: Hello" (case sensitive)
- Buffer unchanged
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('/Hello\n');
        $ctx->delay(300);
        $ctx->snapshot('2');
    },
}
