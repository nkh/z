my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => q{: then Return in command mode},
    description => <<'END_DESC',
Action: : then Return (empty command) returns to normal

_1.png (initial state):
- Normal mode

Action: keystrokes ":Return" (enter command mode, empty command)

_2.png (after action):
- Mode label: "-- NORMAL --"
- Buffer unchanged
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys(':\\n');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
