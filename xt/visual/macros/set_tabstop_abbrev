my $CODE = "\tindented line one\n\tindented line two\n\tnormal line three\n";

{
    desc => ':set ts=8 abbreviation sets tabstop width',
    description => <<'END_DESC',
Macro: `xt/visual/macros/set_tabstop_abbrev`

Tests that `:set ts=8` is accepted as an abbreviation for `:set tabstop=8`
and changes the visual display width of tab characters to 8 columns.

Ex: `:set ts=8`

- **set_tabstop_abbrev_initial.png**: Default tabstop width; tab characters at default width.
- **set_tabstop_abbrev_after_set.png**: After `:set ts=8`, tabs displayed at 8-column width.
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->ex('set ts=8');
        $ctx->delay(200);
        $ctx->snapshot('after_set');
    },
}
