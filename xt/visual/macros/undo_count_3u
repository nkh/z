my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => q{Undo count 3u},
    description => <<'END_DESC',
Action: 3u undoes 3 operations at once

_1.png (initial state):
- 3 lines of text

Action: keystrokes "dddddd3u" (3 dd operations, then undo 3)

_2.png (after action):
- All 3 deleted lines restored by 3u
- Original buffer fully restored
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('dddddd3u');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
