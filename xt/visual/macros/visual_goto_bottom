my $CODE = <<'END_CODE';
#!/usr/bin/perl
use strict;
use warnings;

package My::Module;

sub new {
    my ($class, %opts) = @_;
    return bless \%opts, $class;
}

sub process {
    my ($self, $data) = @_;
    die "No data provided" unless $data;
    my @results;
    for my $item (@$data) {
        push @results, $self->_transform($item);
    }
    return \@results;
}

sub _transform {
    my ($self, $item) = @_;
    return uc($item);
}

1;
END_CODE

{
    desc => q{Go to bottom (G)},
    description => <<'END_DESC',
Action: G jumps to last line

_1.png (initial state):
- Dark theme, cursor at line 1

Action: keystrokes "G" (go to last line)

_2.png (after action):
- Viewport scrolled to show bottom of buffer
- Cursor on last line
- Position label in status bar shows last line position
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->editor->set_language('perl');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('G');
        $ctx->delay(300);
        $ctx->snapshot('2');
    },
}
