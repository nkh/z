my $CODE = <<'END_CODE';
line one
line two
line three
line four
END_CODE

{
    desc => q{Visual line delete},
    description => <<'END_DESC',
Action: V selects lines, d deletes them

_1.png (initial state):
- Cursor at line 1

Action: keystrokes "Vjd" (select 2 lines, delete)

_2.png (after action):
- First 2 lines deleted
- Buffer starts with "line three"
- Cursor at line 1
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('Vjd');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
