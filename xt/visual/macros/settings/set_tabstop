{
    desc => q{:set tabstop=8 changes the visual tab width},
    description => <<'END_DESC',
# set_tabstop, :set tabstop=8 changes the visual tab width

Macro: `xt/visual/macros/settings/set_tabstop`

## initial.png

- Cursor: 1, 0
- Line 1  : 	indented line one
- Line 2  : 	indented line two
- Line 3  : 	normal line three

## tabstop_4.png

- Keys    : :set`Space` tabstop=4

## tabstop_8.png

- Keys    : :set`Space` tabstop=8


END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->ex('set tabstop=4');
        $ctx->delay(200);
        $ctx->snapshot('tabstop_4');
        $ctx->delay(100);
        $ctx->ex('set tabstop=8');
        $ctx->delay(200);
        $ctx->snapshot('tabstop_8');
    },
}
__DATA__
	indented line one
	indented line two
	normal line three
