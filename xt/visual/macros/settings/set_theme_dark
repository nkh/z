{
    desc => ':set theme=dark switches from default to dark theme',
    description => <<'END_DESC',
# set_theme_dark, :set theme=dark switches from default to dark theme

Macro: `xt/visual/macros/settings/set_theme_dark`

## initial.png

- Cursor: 1, 0
- Line 1  : # Theme switch test
- Line 2  : Hello, World!
- Line 3  : my $x = 42;
- Line 4  : print "dark mode\n";

## light_initial.png


## applied.png

- Keys    : :set`Space` theme=dark


END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('default');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('light_initial');
        $ctx->delay(100);
        $ctx->ex('set theme=dark');
        $ctx->delay(200);
        $ctx->snapshot('applied');
    },
}
__DATA__
# Theme switch test
Hello, World!
my $x = 42;
print "dark mode\n";
