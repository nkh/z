{
    desc => ':set nocursorline removes cursor line highlight',
    description => <<'END_DESC',
Macro: `xt/visual/macros/set_nocursorline`

Tests that `:set nocursorline` removes the cursor line highlight that was
previously enabled with `:set cursorline`.

Ex: `:set cursorline` then `:set nocursorline`

- **set_nocursorline_with_highlight.png**: Cursorline enabled; line 1 has a distinct background highlight.
- **set_nocursorline_after_nocursorline.png**: Cursorline disabled; all lines have the same background again.
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->ex('set cursorline');
        $ctx->delay(100);
        $ctx->snapshot('with_highlight');
        $ctx->delay(100);
        $ctx->ex('set nocursorline');
        $ctx->delay(200);
        $ctx->snapshot('after_nocursorline');
    },
}
