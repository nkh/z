{
    desc => ':set nocursorline removes cursor line highlight',
    description => <<'END_DESC',
# set_nocursorline, :set nocursorline removes cursor line highlight

Macro: `xt/visual/macros/settings/set_nocursorline`

## initial.png

- Cursor: 1, 0
- Line 1  : line one
- Line 2  : line two
- Line 3  : line three
- Line 4  : line four
- Line 5  : line five

## with_highlight.png

- Keys    : :set`Space` cursorline

## after_nocursorline.png

- Keys    : :set`Space` nocursorline


END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->ex('set cursorline');
        $ctx->delay(100);
        $ctx->snapshot('with_highlight');
        $ctx->delay(100);
        $ctx->ex('set nocursorline');
        $ctx->delay(200);
        $ctx->snapshot('after_nocursorline');
    },
}
