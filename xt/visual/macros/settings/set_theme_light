{
    desc => ':set theme=light switches from dark to light theme',
    description => <<'END_DESC',
# set_theme_light, :set theme=light switches from dark to light theme

Macro: `xt/visual/macros/settings/set_theme_light`

## initial.png

- Cursor: 1, 0
- Line 1  : # Theme switch test
- Line 2  : Hello, World!
- Line 3  : my $x = 42;
- Line 4  : print "light mode\n";

## dark_initial.png


## applied.png

- Keys    : :set`Space` theme=light


END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('dark_initial');
        $ctx->delay(100);
        $ctx->ex('set theme=light');
        $ctx->delay(200);
        $ctx->snapshot('applied');
    },
}
__DATA__
# Theme switch test
Hello, World!
my $x = 42;
print "light mode\n";
