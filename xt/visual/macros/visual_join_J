my $CODE = <<'END_CODE';
hello
world
this is a test
END_CODE

{
    desc => q{Visual join lines J},
    description => <<'END_DESC',
Action: V selects lines, J joins them

_1.png (initial state):
- Cursor at line 1

Action: keystrokes "VjjJ" (select 3 lines, join)

_2.png (after action):
- All 3 lines joined into one: "hello world this is a test"
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('VjjJ');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
