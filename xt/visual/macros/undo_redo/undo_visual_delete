{
    desc => q{u undoes visual mode character delete},
    description => <<'END_DESC',
# undo_visual_delete, u undoes visual mode character delete

Macro: `xt/visual/macros/undo_redo/undo_visual_delete`

## initial.png

- Cursor: 1, 0
- Line 1  : hello world

## after_visual_delete.png

- Keys    : v lll d

## after_undo.png

- Keys    : u


END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('v');
        $ctx->keys('lll');
        $ctx->keys('d');
        $ctx->delay(100);
        $ctx->snapshot('after_visual_delete');
        $ctx->delay(100);
        $ctx->keys('u');
        $ctx->delay(100);
        $ctx->snapshot('after_undo');
    },
}
