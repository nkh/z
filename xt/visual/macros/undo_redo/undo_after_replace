{
    desc => q{u undoes replace mode changes},
    description => <<'END_DESC',
# undo_after_replace, u undoes replace mode changes

Macro: `xt/visual/macros/undo_redo/undo_after_replace`

## initial.png

- Cursor: 1, 0
- Line 1  : hello world

## after_replace.png

- Keys    : RXXXX

## after_undo.png

- Keys    : u


END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('RXXXX');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('after_replace');
        $ctx->delay(100);
        $ctx->keys('u');
        $ctx->delay(100);
        $ctx->snapshot('after_undo');
    },
}
