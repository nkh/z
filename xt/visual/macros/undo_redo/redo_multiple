{
    desc => q{Ctrl-r redoes multiple undone operations},
    description => <<'END_DESC',
# redo_multiple, Ctrl-r redoes multiple undone operations

Macro: `xt/visual/macros/undo_redo/redo_multiple`

## initial.png

- Cursor: 1, 0
- Line 1  : one
- Line 2  : two
- Line 3  : three

## after_both_dd.png

- Keys    : dd dd

## after_both_undo.png

- Keys    : u u

## after_both_redo.png

- Keys    : Control-r Control-r


END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('dd');
        $ctx->delay(50);
        $ctx->keys('dd');
        $ctx->delay(100);
        $ctx->snapshot('after_both_dd');
        $ctx->delay(100);
        $ctx->keys('u');
        $ctx->delay(50);
        $ctx->keys('u');
        $ctx->delay(100);
        $ctx->snapshot('after_both_undo');
        $ctx->delay(100);
        $ctx->keys('Control-r');
        $ctx->delay(50);
        $ctx->keys('Control-r');
        $ctx->delay(100);
        $ctx->snapshot('after_both_redo');
    },
}
__DATA__
one
two
three
