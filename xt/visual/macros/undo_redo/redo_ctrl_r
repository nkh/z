{
    desc => q{Ctrl-r redoes the last undone change},
    description => <<'END_DESC',
# redo_ctrl_r, Ctrl-r redoes the last undone change

Macro: `xt/visual/macros/undo_redo/redo_ctrl_r`

## initial.png

- Cursor: 1, 0
- Line 1  : one
- Line 2  : two
- Line 3  : three

## after_dd.png

- Keys    : dd

## after_undo.png

- Keys    : u

## after_redo.png

- Keys    : Control-r


END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('dd');
        $ctx->delay(100);
        $ctx->snapshot('after_dd');
        $ctx->delay(100);
        $ctx->keys('u');
        $ctx->delay(100);
        $ctx->snapshot('after_undo');
        $ctx->delay(100);
        $ctx->keys('Control-r');
        $ctx->delay(100);
        $ctx->snapshot('after_redo');
    },
}
__DATA__
one
two
three
