my $CODE = <<'END_CODE';
func(arg1, arg2)
line two
END_CODE

{
    desc => q{Bracket match % parentheses},
    description => <<'END_DESC',
Action: % jumps to matching parenthesis

_1.png (initial state):
- Cursor at line 1, col 4 (on '(')

Action: keystrokes "4l%" (move to '(', match)

_2.png (after action):
- Cursor on matching ')' at end of line
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('4l%');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
