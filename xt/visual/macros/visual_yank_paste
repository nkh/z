my $CODE = <<'END_CODE';
hello world this is a test
line two
END_CODE

{
    desc => q{Visual yank then paste},
    description => <<'END_DESC',
Action: v selects text, y yanks, then p pastes

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "vell yp" (select 5 chars, yank, paste)

_2.png (after action):
- "hello" pasted after the selection
- Line 1: "hellohello world this is a test"
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('vell yp');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
