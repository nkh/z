my $CODE = <<'END_CODE';
line one
line two
line three
line four
END_CODE

{
    desc => q{Multiple sequential undo},
    description => <<'END_DESC',
Action: x, x, dd, then u, u, u to undo all

_1.png (initial state):
- 4 lines of text, cursor at line 1

Action: keystrokes "xxdduuu" (multiple edits then full undo)

_2.png (after action):
- Original buffer content fully restored
- All changes undone
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('xxdduuu');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
