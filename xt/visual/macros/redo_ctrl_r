my $CODE = <<'END_CODE';
line one
line two
line three
line four
END_CODE

{
    desc => q{Redo with Ctrl-r restores undone changes},
    description => <<'END_DESC',
Action: Ctrl-r redoes the last undone operation

_1.png (initial state):
- Dark theme with 4 lines of text
- Cursor at line 1, col 0

Action: keystrokes "dduControl-r" (delete line, undo, redo)

_2.png (after action):
- "line one" deleted, then restored by undo, then re-deleted by redo
- Buffer has 3 lines: "line two", "line three", "line four"
- Cursor at line 1, col 0
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('dd');
        $ctx->delay(100);
        $ctx->keys('u');
        $ctx->delay(100);
        $ctx->keys('Control-r');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
