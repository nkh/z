my $CODE = <<'END_CODE';
hello world this is a test
line two
END_CODE

{
    desc => q{Repeat find ;},
    description => <<'END_DESC',
Action: ; repeats last find

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "fo;" (find 'o', repeat find)

_2.png (after action):
- First fo finds 'o' at col 4
- ; finds next 'o' at col 7 (in "world")
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('fo;');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
