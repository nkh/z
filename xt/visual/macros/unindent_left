my $CODE = <<'END_CODE';
        line one
line two
line three
END_CODE

{
    desc => q{Unindent left <<},
    description => <<'END_DESC',
Action: << unindents current line

_1.png (initial state):
- Line 1 has 8 spaces of indentation, cursor at line 1

Action: keystrokes "<<" (unindent line)

_2.png (after action):
- Line 1 indentation reduced by tab width
- Lines 2-3 unchanged
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('<<');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
