my $CODE = <<'END_CODE';
hello world
this is line two
line three
END_CODE

{
    desc => q{Change 2 words 2cw},
    description => <<'END_DESC',
Action: 2cw changes 2 words

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "2cwREPLACEDEscape" (change 2 words)

_2.png (after action):
- "hello world" replaced with "REPLACED"
- Line 1 now: "REPLACED"
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('2cw');
        $ctx->delay(50);
        $ctx->type('REPLACED');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
