my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => q{Visual line delete all lines},
    description => <<'END_DESC',
Action: V selects all lines, d deletes them

_1.png (initial state):
- 3 lines of text, cursor at line 1

Action: keystrokes "VGd" (visual line, go to bottom, delete)

_2.png (after action):
- All lines deleted
- Buffer is empty (single blank line)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('VGd');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
