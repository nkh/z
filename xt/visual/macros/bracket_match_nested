my $CODE = <<'END_CODE';
func(arr[0], { key })
line two
END_CODE

{
    desc => q{Bracket match nested},
    description => <<'END_DESC',
Action: % with nested brackets of different types

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "4l%4l%" (match '(', then '[' inside)

_2.png (after action):
- Cursor navigates through nested bracket pairs
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('4l%4l%');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
