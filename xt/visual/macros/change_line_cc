my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => q{Change line cc},
    description => <<'END_DESC',
Action: cc changes entire line

_1.png (initial state):
- Cursor at line 2

Action: keystrokes "jccnew textEscape" (change line 2)

_2.png (after action):
- Line 2 replaced with "new text"
- Lines 1 and 3 unchanged
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->keys('j');
        $ctx->delay(50);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('cc');
        $ctx->delay(50);
        $ctx->type('new text');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
