my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => q{Delete character x},
    description => <<'END_DESC',
Action: x deletes character under cursor

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "xxx" (delete 3 characters)

_2.png (after action):
- Line 1 starts with "e one" (first 3 chars 'lin' deleted)
- Cursor at line 1, col 0
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('xxx');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
