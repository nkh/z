my $CODE = <<'END_CODE';
hello world this is a test
line two
END_CODE

{
    desc => q{Change to end of line C},
    description => <<'END_DESC',
Action: C changes from cursor to end of line

_1.png (initial state):
- Cursor at line 1, col 6 (on 'w' of 'world')

Action: keystrokes "CREPLACEDEscape" (change to EOL)

_2.png (after action):
- Everything from col 6 onward replaced with "REPLACED"
- Line 1 now: "hello REPLACED"
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->keys('6l');
        $ctx->delay(50);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('C');
        $ctx->delay(50);
        $ctx->type('REPLACED');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
