my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => q{Open line below o},
    description => <<'END_DESC',
Action: o opens new line below and enters insert mode

_1.png (initial state):
- Normal mode, cursor at line 2

Action: keystrokes "jnew lineEscape" (open below, type, exit)

_2.png (after action):
- New line "new line" inserted between line 2 and line 3
- Buffer now has 4 lines
- Cursor on the new line
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->keys('j');
        $ctx->delay(50);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->key('o');
        $ctx->type('new line');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
