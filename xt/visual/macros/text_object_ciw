my $CODE = <<'END_CODE';
hello world this is a test
line two
END_CODE

{
    desc => q{ciw changes inner word and enters insert mode},
    description => <<'END_DESC',
Action: ciw deletes the inner word and enters insert mode

_1.png (initial state):
- Cursor at line 1, col 0 (on 'h' of 'hello')

Action: keystrokes "ciwNEW\\e" (change inner word to "NEW")

_2.png (after action):
- "hello" replaced with "NEW"
- Line 1 now: "NEW world this is a test"
- Mode label: "-- NORMAL --"
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('ciw');
        $ctx->delay(50);
        $ctx->type('NEW');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
