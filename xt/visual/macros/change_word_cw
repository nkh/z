my $CODE = <<'END_CODE';
hello world test
END_CODE

{
    desc => q{cw changes word},
    description => <<'END_DESC',
Action: `cw` deletes the word under the cursor and enters insert mode

Macro: `xt/visual/macros/change_word_cw`

**initial.png** (before):
- Line 1: `hello world test`
- Cursor at line 1, col 0 (start of `hello`)

Keys: `cw`, type `REPLACED`, `Escape`

**after_cw.png** (after):
- Line 1: `REPLACED world test` (`hello` replaced with `REPLACED`)
- Cursor at line 1, col 8 (after `REPLACED`)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('cw');
        $ctx->delay(50);
        $ctx->type('REPLACED');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('after_cw');
    },
}
