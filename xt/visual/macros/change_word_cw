my $CODE = <<'END_CODE';
hello world this is a test
line two
END_CODE

{
    desc => q{Change word cw},
    description => <<'END_DESC',
Action: cw changes word under cursor

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "cwREPLACEDEscape" (change word)

_2.png (after action):
- "hello" replaced with "REPLACED"
- Line 1 now: "REPLACED world this is a test"
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('cw');
        $ctx->delay(50);
        $ctx->type('REPLACED');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
