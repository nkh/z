my $CODE = <<'END_CODE';
aaa
bbb
ccc
END_CODE

{
    desc => q{gi returns to last insert position},
    description => <<'END_DESC',
## Macro: `xt/visual/macros/gi_return`

Tests that **gi** enters insert mode at the position where the last
insert session ended. After inserting text on line 1 and moving to
line 3, gi returns to the insert point on line 1.

**Keys:** `i`, type `X`, `Escape`, `jj`, `gi`, type `Y`, `Escape`

**initial.png**
- Buffer has 3 lines: "aaa", "bbb", "ccc"
- Cursor on line 1 at column 0

**after_first_insert.png**
- Line 1 reads "Xaaa" (X inserted at column 0)
- Cursor on 'a' at column 1
- Intermediate snapshot after first insert session

**after_move_down.png**
- Cursor moved to line 3 (after `jj`)
- Content unchanged from after_first_insert
- Intermediate snapshot showing cursor moved away

**after_gi_return.png**
- Line 1 reads "XYaaa" (Y inserted at column 1, where last insert ended)
- Cursor on 'a' at column 2
- gi correctly returned to the last insert position
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->key('i');
        $ctx->type('X');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('after_first_insert');
        $ctx->delay(100);
        $ctx->keys('jj');
        $ctx->delay(100);
        $ctx->snapshot('after_move_down');
        $ctx->delay(100);
        $ctx->keys('gi');
        $ctx->type('Y');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('after_gi_return');
    },
}
