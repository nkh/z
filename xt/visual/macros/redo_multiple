my $CODE = <<'END_CODE';
hello world
line two
END_CODE

{
    desc => 'Ctrl-r redo restores multiple undone operations',
    description => <<'END_DESC',
Action: Multiple deletes, undo all, redo all

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "ddddduuControl-rControl-r" (2 deletes, 2 undos, 2 redos)

_2.png (after action):
- Both deletions restored by redo
- Only 1 line remains (same as after both deletes)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('dd');
        $ctx->delay(50);
        $ctx->keys('dd');
        $ctx->delay(50);
        $ctx->keys('u');
        $ctx->delay(50);
        $ctx->keys('u');
        $ctx->delay(50);
        $ctx->keys('Control-r');
        $ctx->delay(50);
        $ctx->keys('Control-r');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
