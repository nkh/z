my $CODE = <<'END_CODE';
line one
line two
line three
line four
line five
END_CODE

{
    desc => ':set nocursorl is abbreviation for :set nocursorline',
    description => <<'END_DESC',
Macro: `xt/visual/macros/set_nocursorline_abbrev`

Tests that `:set nocursorl` is accepted as an abbreviation for
`:set nocursorline` and disables the cursor line highlight.

Ex: `:set cursorline` then `:set nocursorl`

- **set_nocursorline_abbrev_with_highlight.png**: Cursorline enabled; line 1 has a distinct background highlight.
- **set_nocursorline_abbrev_after_nocursorl.png**: Cursorline disabled; all lines have the same background.
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->ex('set cursorline');
        $ctx->delay(200);
        $ctx->snapshot('with_highlight');
        $ctx->delay(100);
        $ctx->ex('set nocursorl');
        $ctx->delay(200);
        $ctx->snapshot('after_nocursorl');
    },
}
