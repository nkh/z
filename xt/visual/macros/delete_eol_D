my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => q{Delete to end of line D},
    description => <<'END_DESC',
Action: D deletes from cursor to end of line

_1.png (initial state):
- Cursor at line 1, col 5 (on 'o' of 'one')

Action: keystrokes "D" (delete to EOL)

_2.png (after action):
- Line 1 is now just "line " (content after col 5 deleted)
- Cursor at line 1, col 4 (last char)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->keys('5l');
        $ctx->delay(50);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('D');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
