my $CODE = <<'END_CODE';
one two three
four five six
seven eight nine
END_CODE

{
    desc => 'Visual block unindent with << unindents block lines',
    description => <<'END_DESC',
Action: Indent lines first, then Ctrl-V select and unindent

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes ">>jj>>kkControl-vjj<<" (indent lines 1 and 3, block select, unindent)

_2.png (after action):
- All 3 lines unindented back
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('>>');
        $ctx->delay(50);
        $ctx->keys('jj>>');
        $ctx->delay(50);
        $ctx->keys('kkControl-vjj');
        $ctx->delay(50);
        $ctx->keys('<<');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
