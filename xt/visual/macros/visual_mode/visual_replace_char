{
    desc => q{Replace mode (r)},
    description => <<'END_DESC',
Action: rx replaces character under cursor with 'x'

-1_initial.png (initial state):
- Default theme, cursor at line 1, col 0 (the '#' character)

Sub-commands: keys('rx')

-2_after.png (after action):
- Line 1 starts with "x!/usr/bin/perl" (first char changed)
- Cursor moved one position to the right
END_DESC
    run => sub {
        my ($ctx) = @_;        $ctx->editor->set_language('perl');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('rx');
        $ctx->delay(100);
        $ctx->snapshot('after');
    },
}__DATA__
