{
    desc => q{Visual block insert A},
    description => <<'END_DESC',
Action: Ctrl-V selects block, A appends text at right edge

-1_initial.png (initial state):
- Cursor at line 1, col 0

Sub-commands: keys('Control-vjj3l'), key('A'), type('<'), key('Escape')

-2_after.png (after action):
- '<' appended after column 3 on each of first 3 lines
- Lines: "abcd<", "efgh<", "ijkl<"
END_DESC
    run => sub {
        my ($ctx) = @_;        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('Control-vjj3l');
        $ctx->delay(50);
        $ctx->key('A');
        $ctx->type('<');
        $ctx->key('Escape');
        $ctx->delay(200);
        $ctx->snapshot('after');
    },
}
