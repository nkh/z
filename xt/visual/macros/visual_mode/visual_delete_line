{
    desc => q{Delete line (dd)},
    description => <<'END_DESC',
Action: dd deletes the current line

-1_initial.png (initial state):
- Default theme with Perl code (starts with #!/usr/bin/perl)

Sub-commands: keys('dd')

-2_after.png (after action):
- First line (#!/usr/bin/perl) is gone
- Cursor at new line 1
- Buffer content is one line shorter
END_DESC
    run => sub {
        my ($ctx) = @_;        $ctx->editor->set_language('perl');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('dd');
        $ctx->delay(100);
        $ctx->snapshot('after');
    },
}__DATA__
#!/usr/bin/perl
use strict;
use warnings;
