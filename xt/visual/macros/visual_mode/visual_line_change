{
    desc => q{Visual line change},
    description => <<'END_DESC',
Action: V selects lines, c changes (replaces with typed text)

-1_initial.png (initial state):
- Cursor at line 1

Sub-commands: keys('Vjc'), type('REPLACED'), key('Escape')

-2_after.png (after action):
- First 2 lines replaced with "REPLACED"
- Buffer now has 3 lines (REPLACED + line three + line four)
END_DESC
    run => sub {
        my ($ctx) = @_;        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('Vjc');
        $ctx->delay(50);
        $ctx->type('REPLACED');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('after');
    },
