{
    desc => q{Visual block toggle case},
    description => <<'END_DESC',
Action: Ctrl-V selects block, ~ toggles case

-1_initial.png (initial state):
- Cursor at line 1, col 0

Sub-commands: keys('Control-vjjll~')

-2_after.png (after action):
- First 3 chars of first 3 lines uppercased
- Lines: "ABCd", "EFGh", "IJKl"
- Line 4 unchanged
END_DESC
    run => sub {
        my ($ctx) = @_;        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('Control-vjjll~');
        $ctx->delay(100);
        $ctx->snapshot('after');
    },
}__DATA__
abcd
efgh
ijkl
