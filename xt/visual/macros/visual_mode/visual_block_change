{
    desc => 'Visual block change replaces block with typed text',
    description => <<'END_DESC',
Action: Ctrl-V block select, c changes to typed text

-1_initial.png (initial state):
- Cursor at line 1, col 0

Sub-commands: keys('Control-vjj'), key('c'), type('XX'), key('Escape')

-2_after.png (after action):
- First 2 chars of each of first 3 lines replaced with "XX"
- Lines: "XXcd", "XXgh", "XXkl"
END_DESC
    run => sub {
        my ($ctx) = @_;        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('Control-vjj');
        $ctx->delay(50);
        $ctx->key('c');
        $ctx->delay(50);
        $ctx->type('XX');
        $ctx->key('Escape');
        $ctx->delay(200);
        $ctx->snapshot('after');
    },
