{
    desc => 'Visual block uppercase U converts block to uppercase',
    description => <<'END_DESC',
Action: Ctrl-V block select, U uppercases all block text

-1_initial.png (initial state):
- Cursor at line 1, col 0

Sub-commands: keys('Control-vjjl'), key('U')

-2_after.png (after action):
- First 2 chars of each of first 3 lines uppercased
- Lines: "ABcd", "EFgh", "IJkl"
END_DESC
    run => sub {
        my ($ctx) = @_;        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('Control-vjjl');
        $ctx->delay(50);
        $ctx->key('U');
        $ctx->delay(100);
        $ctx->snapshot('after');
    },
}
