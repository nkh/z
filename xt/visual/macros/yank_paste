my $CODE = <<'END_CODE';
hello world
END_CODE

{
    desc => 'yw then p yanks a word and pastes it after cursor',
    description => <<'END_DESC',
Macro: `xt/visual/macros/yank_paste`

Tests `yw` to yank a word, then `p` to paste it after the cursor.

**initial.png** — Buffer shows `hello world`. Cursor at line 1 col 0.

Keys: `yw` then `w` then `p`

**after_yank_word.png** — Intermediate state: `hello` yanked, cursor moved
to `world`.

**after_paste.png** — `hello` is pasted after `world`.
Line 1 now reads `worldhello` with the cursor between them.
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('yw');
        $ctx->delay(50);
        $ctx->keys('w');
        $ctx->delay(50);
        $ctx->snapshot('after_yank_word');
        $ctx->delay(100);
        $ctx->keys('p');
        $ctx->delay(100);
        $ctx->snapshot('after_paste');
    },
}
