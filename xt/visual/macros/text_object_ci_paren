my $CODE = <<'END_CODE';
my $x = "hello";
my $y = 'world';
my $z = ($x + $y);
END_CODE

{
    desc => 'ci( changes text inside parentheses',
    description => <<'END_DESC',
Action: ci( deletes text inside parens and enters insert mode

_1.png (initial state):
- Cursor at line 3, col 10 (inside parentheses)

Action: keystrokes "ci(42\\e" (change inner parens to "42")

_2.png (after action):
- Text between ( and ) changed to "42"
- Line 3: 'my $z = (42);'
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->editor->set_language('perl');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('jjlllllllll');
        $ctx->delay(50);
        $ctx->keys('ci(');
        $ctx->delay(50);
        $ctx->type('42');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
