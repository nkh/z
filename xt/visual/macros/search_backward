my $CODE = <<'END_CODE';
hello world
hello again
goodbye world
END_CODE

{
    desc => q{Search backward ?pattern},
    description => <<'END_DESC',
Action: ? searches backward for pattern

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "jj?helloReturn" (move to line 3, search backward)

_2.png (after action):
- Cursor on line 2 where "hello" is found (searching backward from line 3)
- "hello" highlighted on line 2
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->keys('jj');
        $ctx->delay(50);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('?hello\\n');
        $ctx->delay(300);
        $ctx->snapshot('2');
    },
}
