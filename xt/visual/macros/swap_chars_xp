my $CODE = <<'END_CODE';
abCDefgh
line two
END_CODE

{
    desc => q{Swap characters xp},
    description => <<'END_DESC',
Action: xp swaps character under cursor with next

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "xp" (delete char then paste = swap)

_2.png (after action):
- Characters swapped: "baCDefgh" (first two chars transposed)
- Cursor at line 1, col 1
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('xp');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
