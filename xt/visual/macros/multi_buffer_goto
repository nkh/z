{
    desc => q{:b<N> switches to buffer by number},
    description => <<'END_DESC',
Action: :b2 switches directly to buffer 2

_1.png (initial state):
- Editor on buffer 1 after opening two temp files

Sub-commands: keys(':b2'), key('Enter')

_2.png (after action):
- Buffer content switches to the second file
- Tests :b<N> (buffer goto) command
END_DESC
    run => sub {
        my ($ctx) = @_;

        # Create two temporary files
        require File::Temp;
        my ($fh1, $f1) = File::Temp::tempfile(SUFFIX => '.txt', UNLINK => 1, DIR => '/tmp');
        print $fh1 "Buffer One - First File\nLine 2 of file 1\nLine 3\n";
        close $fh1;

        my ($fh2, $f2) = File::Temp::tempfile(SUFFIX => '.txt', UNLINK => 1, DIR => '/tmp');
        print $fh2 "Buffer Two - Second File\nLine 2 of file 2\n";
        close $fh2;

        # Open both files
        $ctx->ex("e $f1");
        $ctx->delay(200);
        $ctx->ex("e $f2");
        $ctx->delay(200);

        # Go back to buffer 1
        $ctx->ex('bp');
        $ctx->delay(200);

        # We're on buffer 1 - snapshot shows buffer 1 content
        $ctx->snapshot('1');

        # Jump directly to buffer 2
        $ctx->ex('b2');
        $ctx->delay(200);
        $ctx->snapshot('2');
    },
}
