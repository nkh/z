my $CODE = <<'END_CODE';
abcd
efgh
ijkl
END_CODE

{
    desc => q{Visual block insert A},
    description => <<'END_DESC',
Action: Ctrl-V selects block, A appends text at right edge

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "Control-vjj3lA<Escape" (block select, move right, append '<')

_2.png (after action):
- '<' appended after column 3 on each of first 3 lines
- Lines: "abcd<", "efgh<", "ijkl<"
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('Control-vjj3l');
        $ctx->delay(50);
        $ctx->key('A');
        $ctx->type('<');
        $ctx->key('Escape');
        $ctx->delay(200);
        $ctx->snapshot('2');
    },
}
