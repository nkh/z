my $CODE = <<'END_CODE';
hello world
line two
END_CODE

{
    desc => q{Replace mode backspace},
    description => <<'END_DESC',
Action: R enters replace mode, type, backspace undoes last replace

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "RXYBackSpaceEscape" (replace 2 chars, undo 1)

_2.png (after action):
- Only "X" replaced (Y undone by backspace): "Xllo world"
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('RXY\\b\\e');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
