my $CODE = <<'END_CODE';
hello world this is a test
line two
END_CODE

{
    desc => q{Till char forward t},
    description => <<'END_DESC',
Action: t moves cursor to character before target

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "tw" (till 'w' forward)

_2.png (after action):
- Cursor one position before 'w' in "world" (col 5, the space)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('tw');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
