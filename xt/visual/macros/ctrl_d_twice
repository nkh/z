{
    desc => q{2 Ctrl-d = two half-pages},
    description => <<'END_DESC',
Action: Two consecutive Ctrl-d scrolls two half-pages

_1.png (initial state):
- Cursor at line 1

Action: keystrokes "Control-dControl-d" (two half-pages down)

_2.png (after action):
- Viewport scrolled down approximately one full page
- Cursor moved down accordingly
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('Control-dControl-d');
        $ctx->delay(200);
        $ctx->snapshot('2');
    },
}
