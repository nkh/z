my $CODE = <<'END_CODE';
hello world
line two
END_CODE

{
    desc => q{Visual uppercase U},
    description => <<'END_DESC',
Action: v selects chars, U uppercases selection

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "veeU" (select 2 words, uppercase)

_2.png (after action):
- "HELLO WORLD" (first 2 words uppercased)
- Line 1: "HELLO WORLD"
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('veeU');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
