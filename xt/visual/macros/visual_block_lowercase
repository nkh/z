my $CODE = <<'END_CODE';
ABCD
EFGH
IJKL
MNOP
QRST
END_CODE

{
    desc => 'Visual block lowercase u converts block to lowercase',
    description => <<'END_DESC',
Action: Ctrl-V block select, u lowercases all block text

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "Control-vjjlu" (block select 3 rows x 2 cols, lowercase)

_2.png (after action):
- First 2 chars of each of first 3 lines lowercased
- Lines: "abCD", "efGH", "ijKL"
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('Control-vjjl');
        $ctx->delay(50);
        $ctx->key('u');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
