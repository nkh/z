my $CODE = <<'END_CODE';
line one
line two
line three
line four
line five
line six
line seven
line eight
line nine
line ten
END_CODE

{
    desc => q{Count prefix 10j motion},
    description => <<'END_DESC',
Action: 10j moves cursor down 10 lines (clamps to last line)

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "10j" (count + down, exceeds buffer)

_2.png (after action):
- Cursor clamped to last line (line 10)
- Viewport scrolled to bottom
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('10j');
        $ctx->delay(200);
        $ctx->snapshot('2');
    },
}
