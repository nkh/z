my $CODE = <<'END_CODE';
hello world
line two
END_CODE

{
    desc => q{Search not found error},
    description => <<'END_DESC',
Action: /pattern when pattern not found shows error

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "/zzzReturn" (search for non-existent pattern)

_2.png (after action):
- Error message visible in mode label or status area
- "Pattern not found: zzz" or similar
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('/zzz\\n');
        $ctx->delay(300);
        $ctx->snapshot('2');
    },
}
