my $CODE = <<'END_CODE';
hello world
END_CODE

{
    desc => q{F{char} moves cursor backward to previous occurrence of character},
    description => <<'END_DESC',
## Macro: `xt/visual/macros/find_char_F`

**F{char}** moves the cursor backward to the previous occurrence of the specified character on the current line.

**Keys:** `$Fo`

**initial.png**
- Cursor at line 1, col 10 (on 'd' of "world", end of line)
- Text: `hello world`

**after_Fo.png**
- Cursor moved backward to the 'o' in "world" at col 7
- Text unchanged
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('$Fo');
        $ctx->delay(100);
        $ctx->snapshot('after_Fo');
    },
}
