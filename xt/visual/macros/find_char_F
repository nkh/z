my $CODE = <<'END_CODE';
hello world this is a test
line two
END_CODE

{
    desc => q{Find char backward F},
    description => <<'END_DESC',
Action: F moves cursor to previous occurrence of character

_1.png (initial state):
- Cursor at line 1, col 10 (on 'i' in "this")

Action: keystrokes "10lFo" (move right, find 'o' backward)

_2.png (after action):
- Cursor on the 'o' in "world" (col 7)
- No text change
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('10lFo');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
