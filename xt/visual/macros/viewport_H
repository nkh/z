{
    desc => q{H moves cursor to top of viewport},
    description => <<'END_DESC',
Macro: `xt/visual/macros/viewport_H`

Tests that `H` jumps the cursor to the top line of the current viewport. The buffer has 40 lines to ensure scrolling occurs.

Keys: `G` → `H`

- **viewport_H_initial.png**: Cursor at line 1, col 0 on "viewport line 01"
- **viewport_H_at_bottom.png**: Cursor at line 40 (last line) after `G`; viewport scrolled to bottom
- **viewport_H_after_H.png**: Cursor jumped to the top line of the visible viewport (not line 1 of file, but top of current view)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('G');
        $ctx->delay(200);
        $ctx->snapshot('at_bottom');
        $ctx->delay(100);
        $ctx->keys('H');
        $ctx->delay(200);
        $ctx->snapshot('after_H');
    },
}
