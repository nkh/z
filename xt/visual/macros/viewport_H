{
    desc => q{Viewport H (top of viewport)},
    description => <<'END_DESC',
Action: H moves cursor to top of viewport

_1.png (initial state):
- Cursor at line 1

Action: keystrokes "GH" (go to bottom, then H to top of viewport)

_2.png (after action):
- Cursor on top line of visible viewport
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('GH');
        $ctx->delay(200);
        $ctx->snapshot('2');
    },
}
