my $CODE = <<'END_CODE';
/* Editor theme overrides */
.editor {
    font-family: monospace;
    font-size: 12px;
    color: #d4d4d4;
    background: #1e1e1e;
}

.editor .gutter {
    color: #858585;
    border-right: 1px solid #333;
}
END_CODE

{
    desc => q{CSS syntax},
    description => <<'END_DESC',
Syntax highlighting: CSS

Visual checks:
- Selectors (.editor, .gutter) colored
- Properties (font-family, color, background) colored
- Values (monospace, #d4d4d4, 12px) colored
- Comments (/* */) have comment color
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_language('css');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot();
    },
}
