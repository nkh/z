my $CODE = join("\n", map { "scroll line $_" } 1..40);

{
    desc => 'Ctrl-u scrolls viewport up by half a page',
    description => <<'END_DESC',
Macro: `xt/visual/macros/ctrl_u_scroll`

Tests that `Ctrl-u` scrolls the viewport up by approximately half a page.
The buffer has 40 numbered lines; we first go to the bottom so scrolling
up is clearly visible.

Keys: `G` then `Ctrl-u`

- **ctrl_u_scroll_initial.png**: Cursor at line 1 col 0 on "scroll line 1".
- **ctrl_u_scroll_at_bottom.png**: After `G`, cursor at line 40 (last line), viewport showing bottom of file.
- **ctrl_u_scroll_after_ctrl_u.png**: Viewport scrolled up ~half a page; cursor moved up accordingly.
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('G');
        $ctx->delay(200);
        $ctx->snapshot('at_bottom');
        $ctx->delay(100);
        $ctx->keys('Control-u');
        $ctx->delay(200);
        $ctx->snapshot('after_ctrl_u');
    },
}
