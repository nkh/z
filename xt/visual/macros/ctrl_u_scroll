{
    desc => q{Ctrl-u half-page up},
    description => <<'END_DESC',
Action: Ctrl-u scrolls viewport up by half a page

_1.png (initial state):
- Cursor at line 1

Action: keystrokes "GControl-u" (go to bottom, then half-page up)

_2.png (after action):
- Viewport scrolled up from bottom (approximately half a page)
- Cursor moved up
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('GControl-u');
        $ctx->delay(200);
        $ctx->snapshot('2');
    },
}
