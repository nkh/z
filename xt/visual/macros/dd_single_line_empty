my $CODE = <<'END_CODE';
only one line here
END_CODE

{
    desc => q{dd on single line makes empty},
    description => <<'END_DESC',
Action: dd on a buffer with one line

_1.png (initial state):
- Single line buffer, cursor at line 1

Action: keystrokes "dd" (delete line)

_2.png (after action):
- Buffer is now empty (one blank line)
- No visible text content
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('dd');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
