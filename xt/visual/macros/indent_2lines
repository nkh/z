my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => '2>> indents 2 lines right',
    description => <<'END_DESC',
Macro: `xt/visual/macros/indent_2lines`

Tests the `2>>` operator which indents the current line and the next line
by one shift width.

**initial.png** — Three lines with no indentation. Cursor at line 1 col 0.

Keys: `2>>`

**after_indent_2lines.png** — Lines 1 and 2 are both indented (shifted right).
Line 3 remains unchanged.
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('2>>');
        $ctx->delay(100);
        $ctx->snapshot('after_indent_2lines');
    },
}
