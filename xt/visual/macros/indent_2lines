my $CODE = <<'END_CODE';
        line one
        line two
line three
END_CODE

{
    desc => q{Indent 2 lines 2>>},
    description => <<'END_DESC',
Action: 2>> indents 2 lines

_1.png (initial state):
- Lines 1-2 have 8-space indent, cursor at line 1

Action: keystrokes "2>>" (indent 2 lines)

_2.png (after action):
- Lines 1-2 indented further (additional shift)
- Line 3 unchanged
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('2>>');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
