my $CODE = <<'END_CODE';
hello world
line two
END_CODE

{
    desc => q{Replace mode R},
    description => <<'END_DESC',
Action: R enters replace mode, type overwrites characters

_1.png (initial state):
- Normal mode, cursor at line 1, col 0

Action: keystrokes "RXXXXEscape" (replace 4 chars)

_2.png (after action):
- "XXXX" replaced first 4 chars of "hello": "XXXXo world"
- Mode label: "-- NORMAL --"
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('RXXXX\\e');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
