my $CODE = <<'END_CODE';
line one
line two
line three
line four
line five
END_CODE

{
    desc => q{Insert mode typing text},
    description => <<'END_DESC',
Action: i enters insert mode, type text, Esc exits

_1.png (initial state):
- Normal mode, cursor at line 1, col 0

Action: keystrokes "iHello Escape" (insert "Hello" then exit)

_2.png (after action):
- Line 1 now starts with "Hello" (inserted before 'l')
- Mode label shows "-- NORMAL --"
- Cursor after the inserted text
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->key('i');
        $ctx->type('Hello');
        $ctx->key('Escape');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
