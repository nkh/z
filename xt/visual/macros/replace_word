my $CODE = <<'END_CODE';
hello world
END_CODE

{
    desc => q{r replaces single character},
    description => <<'END_DESC',
Action: `r` replaces the character under the cursor with the next typed character

Macro: `xt/visual/macros/replace_word`

**initial.png** (before):
- Line 1: `hello world`
- Cursor at line 1, col 0

Keys: `4lrO`

**after_replace.png** (after):
- Line 1: `hellO world` (`o` at col 4 replaced with `O`)
- Cursor at line 1, col 4 (on `O`)
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('4lrO');
        $ctx->delay(100);
        $ctx->snapshot('after_replace');
    },
}
