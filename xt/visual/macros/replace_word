my $CODE = <<'END_CODE';
hello world
line two
END_CODE

{
    desc => q{Replace entire word},
    description => <<'END_DESC',
Action: R replaces characters across a word

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "RBYE\\e" (replace "hello" with "BYE  ")

_2.png (after action):
- "hello" replaced with "BYE  " (5 chars): "BYE  world"
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('RBYE \\e');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
