my $CODE = <<'END_CODE';
line one
line two
line three
line four
line five
line six
line seven
line eight
line nine
line ten

END_CODE

{
    desc => q{Go to top gg},
    description => <<'END_DESC',
Action: `G` goes to bottom of file, `gg` returns to top

Macro: `xt/visual/macros/basic_navigation_gg`

**initial.png** (before):
- 10 lines of text (`line one` through `line ten`)
- Cursor at line 1, col 0

Keys: `G`

**mid_bottom.png** (after `G`):
- Cursor at line 10, col 0 (last line)
- Viewport scrolled to show bottom of buffer

Keys: `gg`

**after_action.png** (after `gg`):
- Cursor at line 1, col 0 (back at top)
- Viewport scrolled back to top of buffer

END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('initial');
        $ctx->delay(100);
        $ctx->keys('G');
        $ctx->delay(200);
        $ctx->snapshot('mid_bottom');
        $ctx->delay(200);
        $ctx->keys('gg');
        $ctx->delay(100);
        $ctx->snapshot('after_action');
    },
}
