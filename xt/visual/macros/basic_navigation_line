my $CODE = <<'END_CODE';
    indented line one
    indented line two
short line
    indented line four
END_CODE

{
    desc => q{Line motions 0/$/  ^},
    description => <<'END_DESC',
Action: $ moves to end of line

_1.png (initial state):
- Cursor at line 1, col 0 (start of indented line)

Action: keystrokes "$" (move to end of line)

_2.png (after action):
- Cursor at line 1, last character column
- No text content change
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('$');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
