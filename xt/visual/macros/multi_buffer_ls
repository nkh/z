{
    desc => q{:ls lists open buffers in mode label},
    description => <<'END_DESC',
Action: :ls displays the buffer list in the mode label area

_1.png (initial state):
- Editor with default content, NORMAL mode

Sub-commands: Create temp files, open them with :e, then run :ls

_2.png (after action):
- Mode label shows buffer list with indices, filenames, and markers
- % marks current buffer, + marks modified
- Tests multi-buffer :ls command output
END_DESC
    run => sub {
        my ($ctx) = @_;

        # Create two temporary files
        require File::Temp;
        my ($fh1, $f1) = File::Temp::tempfile(SUFFIX => '.txt', UNLINK => 1, DIR => '/tmp');
        print $fh1 "First buffer content\nLine 2 of buffer 1\nLine 3\n";
        close $fh1;

        my ($fh2, $f2) = File::Temp::tempfile(SUFFIX => '.txt', UNLINK => 1, DIR => '/tmp');
        print $fh2 "Second buffer content\nLine 2 of buffer 2\n";
        close $fh2;

        $ctx->delay(100);
        $ctx->snapshot('1');

        # Open first file via :e
        $ctx->ex("e $f1");
        $ctx->delay(200);

        # Open second file via :e
        $ctx->ex("e $f2");
        $ctx->delay(200);

        # Now list buffers
        $ctx->ex('ls');
        $ctx->delay(200);
        $ctx->snapshot('2');
    },
}
