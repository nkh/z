my $CODE = <<'END_CODE';
line one
line two
line three
END_CODE

{
    desc => q{Indent right >>},
    description => <<'END_DESC',
Action: >> indents current line

_1.png (initial state):
- No indentation, cursor at line 1

Action: keystrokes ">>" (indent line)

_2.png (after action):
- Line 1 indented (shifted right by tab width)
- Lines 2-3 unchanged
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('>>');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
