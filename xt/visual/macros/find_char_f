my $CODE = <<'END_CODE';
hello world this is a test
line two
END_CODE

{
    desc => q{Find char forward f},
    description => <<'END_DESC',
Action: f moves cursor to next occurrence of character

_1.png (initial state):
- Cursor at line 1, col 0

Action: keystrokes "fo" (find 'o' forward)

_2.png (after action):
- Cursor on first 'o' in "hello" (col 4)
- No text change
END_DESC
    run => sub {
        my ($ctx) = @_;
        $ctx->editor->set_theme('dark');
        $ctx->buffer->set_text($CODE);
        $ctx->delay(100);
        $ctx->snapshot('1');
        $ctx->delay(100);
        $ctx->keys('fo');
        $ctx->delay(100);
        $ctx->snapshot('2');
    },
}
